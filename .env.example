# Billing — variáveis de ambiente (cliente)

# Firebase — obtenha no Console Firebase > Configurações do projeto
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_STORAGE_BUCKET=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=
REACT_APP_FIREBASE_MEASUREMENT_ID=

# Emuladores locais — use true apenas em desenvolvimento com `firebase emulators:start`
REACT_APP_USE_FIREBASE_EMULATORS=false

# Billing — Stripe Studio checkout (Beta: habilitado por padrão)
# Opt-out: defina false apenas se STRIPE_PRICE_STUDIO NÃO estiver configurado no backend.
# Backend permanece a fonte de verdade do priceId (STRIPE_PRICE_STUDIO).
# Matriz comercial UI: src/config/planLimits.js (Professional R$ 49 / Studio R$ 199).
# REACT_APP_STRIPE_STUDIO_CHECKOUT=false

# Embed — base URL do app para /embed, prévia e snippet (sem hardcode no componente)
# Opcional em desenvolvimento; usa window.location.origin como fallback.
# Em produção: https://app.fivi360.com.br
# Reinicie o CRACO após alterar REACT_APP_* (.env é lido no startup).
REACT_APP_APP_BASE_URL=

# URL pública do site/marketing (portfólio, Settings). NÃO é usada pelo Embed.
# REACT_APP_PUBLIC_URL=https://fivi360.com.br

# Destino da marca Powered by FIVI360 (fallback: home)
# REACT_APP_MARKETING_ARCHITECTS_URL=https://fivi360.com.br/para-arquitetos
