# Shared non-sensitive Cloud Functions config (safe to commit).
# Local overrides: .env.local | Secrets: .secret.local
# Restart the Functions emulator after changes.

APP_BASE_URL=http://localhost:3000

# Optional shared defaults (leave empty; prefer .env.local for account-specific Price IDs)
# STRIPE_PRICE_PROFESSIONAL=
# STRIPE_PRICE_STUDIO=
# RESEND_FROM_EMAIL=

# Paid checkout gate (RC-MANUAL-PLAN-AND-PAYMENTS-GATE-1). Go-live: false.
# Local Stripe tests: set true in .env.local
PAID_CHECKOUT_ENABLED=false
