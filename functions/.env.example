# =============================================================================
# Cloud Functions — environment template (RC-FUNCTIONS-ENV-CLEANUP-1)
# =============================================================================
# Setup (PowerShell):
#   cd functions
#   Copy-Item .env.example .env.local
#   # Create .secret.local for defineSecret values (see Secrets section below)
#
# Precedence (Firebase Emulator):
#   .env  <  .env.local  (non-secret params / process.env)
#   .secret.local        (defineSecret only — required by Firebase CLI)
#
# Restart the Functions emulator after any change to these files.
# Never commit real secrets. Production uses Google Secret Manager.
# =============================================================================

# --- App (NON_SECRET_SERVER_CONFIG) — .env or .env.local ---
APP_BASE_URL=http://localhost:3000

# --- Resend (NON_SECRET_SERVER_CONFIG) — .env or .env.local ---
# Code reads RESEND_FROM_EMAIL (not RESEND_FROM).
RESEND_FROM_EMAIL=

# --- Stripe Price IDs (NON_SECRET_SERVER_CONFIG) — .env or .env.local ---
# defineString params. Price IDs are not secrets, but are environment-specific.
STRIPE_PRICE_PROFESSIONAL=
STRIPE_PRICE_STUDIO=

# Optional alias (fallback only for studio if STRIPE_PRICE_STUDIO is empty):
# STRIPE_PRICE_STUDIO_MONTHLY=

# Unused / obsolete aliases (do not rely on these):
# STRIPE_PRICE_PROFESSIONAL_MONTHLY=
# STRIPE_PRICE_ENTERPRISE=
# STRIPE_PRICE_ENTERPRISE_MONTHLY=

# =============================================================================
# Secrets (SECRET) — put ONLY in functions/.secret.local
# =============================================================================
# Firebase defineSecret does NOT load secrets from .env / .env.local.
# Create functions/.secret.local (gitignored) with:
#
#   STRIPE_SECRET_KEY=
#   STRIPE_WEBHOOK_SECRET=
#   RESEND_API_KEY=
#
# Production: firebase functions:secrets:set <NAME>
# =============================================================================
