rules_version = '2';

// --------------------------------------------------------------------------
// FIVI360 — Storage Security Rules (Sprint 13.3)
//
// Paths usados pelo app (imageService):
//   users/{userId}/projects/{projectId}/images/{imageId}.webp
//   users/{userId}/images/{imageId}.webp
//
// Leitura/escrita: apenas o dono autenticado (request.auth.uid == userId).
//
// TRADE-OFF — URLs de download com token:
// O app grava previewUrl/originalUrl (getDownloadURL) no Firestore. Essas URLs
// incluem um access token e continuam acessíveis a quem possui o link, mesmo
// com read restrito aqui. Conteúdo compartilhado depende disso até migrarmos
// para signed URLs curtas ou Cloud Function. Ver docs/security-rules-notes.md.
//
// Paths legados (projects/, images/ na raiz) não são usados pelo app v2 —
// negados explicitamente.
// --------------------------------------------------------------------------

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    match /users/{userId}/{allPaths=**} {
      allow read, write: if isOwner(userId);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
