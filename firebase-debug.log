[debug] [2026-06-17T19:46:42.665Z] >>> [apiv2][body] PUT http://127.0.0.1:8080/emulator/v1/projects/fivi360:securityRules {"ignore_errors":true,"rules":{"files":[{"name":"security.rules","content":"rules_version = '2';\r\n\r\n// --------------------------------------------------------------------------\r\n// FIVI360 — Firestore Security Rules (Sprint Public Profile Cleanup 2)\r\n//\r\n// Coleções:\r\n//   users/{userId}              — dados privados (plano, billing, legal)\r\n//   publicProfiles/{userId}     — dados públicos do portfólio\r\n//   workspaces/{workspaceId}    — fundação multiusuário (workspace pessoal)\r\n//   workspaces/{workspaceId}/members/{uid}\r\n//   slugs/{slug}                — resolução /u/:slug\r\n//   projects/{projectId}\r\n//   images/{imageId}\r\n//   images/{imageId}/hotspots/{hotspotId}\r\n//   stats/{userId}                  — contadores agregados de portfólio\r\n//   stats/{userId}/projects/{projectId} — contadores de projeto público\r\n//   stats/{userId}/images/{imageId}     — contadores de imagem 360 pública\r\n//   invoices/{invoiceId}          — faturas Stripe (escrita via webhook / Admin SDK)\r\n//   emailQueue/{emailId}          — fila de e-mails transacionais (Resend)\r\n//\r\n// Split get vs list: queries precisam provar estaticamente os predicados\r\n// usados em allow list. Ver docs/security-rules-notes.md.\r\n// --------------------------------------------------------------------------\r\n\r\nservice cloud.firestore {\r\n  match /databases/{database}/documents {\r\n\r\n    // ---------- helpers ----------\r\n\r\n    function isSignedIn() {\r\n      return request.auth != null;\r\n    }\r\n\r\n    function isOwner(userId) {\r\n      return isSignedIn() && request.auth.uid == userId;\r\n    }\r\n\r\n    function isValidVisibility(value) {\r\n      return value in ['private', 'shared', 'public'];\r\n    }\r\n\r\n    function isShared(value) {\r\n      return value == 'shared' || value == 'public';\r\n    }\r\n\r\n    function projectDoc(projectId) {\r\n      return get(/databases/$(database)/documents/projects/$(projectId));\r\n    }\r\n\r\n    function projectExists(projectId) {\r\n      return exists(/databases/$(database)/documents/projects/$(projectId));\r\n    }\r\n\r\n    function projectBelongsToCaller(projectId) {\r\n      return projectId == null\r\n        || (\r\n          projectExists(projectId)\r\n          && projectDoc(projectId).data.userId == request.auth.uid\r\n        );\r\n    }\r\n\r\n    function isValidSlug(slug) {\r\n      return slug.matches('^[a-z0-9]+(-[a-z0-9]+)*$');\r\n    }\r\n\r\n    function isAllowedClientEmailType(type) {\r\n      return type in ['welcome', 'verify_email', 'billing_upgrade_requested'];\r\n    }\r\n\r\n    function isValidEmailQueueCreate() {\r\n      return request.resource.data.keys().hasAll(['type', 'to', 'userId', 'payload', 'status', 'createdAt'])\r\n        && request.resource.data.userId == request.auth.uid\r\n        && request.resource.data.to == request.auth.token.email\r\n        && request.resource.data.status == 'pending'\r\n        && isAllowedClientEmailType(request.resource.data.type)\r\n        && request.resource.data.to is string\r\n        && request.resource.data.payload is map\r\n        && request.resource.data.createdAt is timestamp\r\n        && !request.resource.data.keys().hasAny(['sentAt', 'resendId', 'error']);\r\n    }\r\n\r\n    // Portfólio /u/:slug — listagem de projetos públicos exige portfolioAvailable.\r\n    // get individual de projeto shared/public (ex.: /share/project) não usa este helper.\r\n    function portfolioAvailableForOwner(userId) {\r\n      return exists(/databases/$(database)/documents/publicProfiles/$(userId))\r\n        && get(/databases/$(database)/documents/publicProfiles/$(userId)).data.portfolioAvailable == true;\r\n    }\r\n\r\n    // Projeto shared/public — usado em get/list de imagens por projectId.\r\n    function isPublicProject(projectId) {\r\n      return projectExists(projectId)\r\n        && isShared(projectDoc(projectId).data.visibility);\r\n    }\r\n\r\n    // Get individual: imagem shared OU projeto pai shared/public.\r\n    function imageIsPubliclyReadable(imageData) {\r\n      return isShared(imageData.visibility)\r\n        || (\r\n          imageData.projectId != null\r\n          && isPublicProject(imageData.projectId)\r\n        );\r\n    }\r\n\r\n    // List por projectId: só quando o projeto pai é shared/public.\r\n    // Imagens shared em projeto private são acessíveis via get, não via list.\r\n    function imageListableInPublicProject(imageData) {\r\n      return imageData.projectId != null\r\n        && isPublicProject(imageData.projectId);\r\n    }\r\n\r\n    function imageExists(imageId) {\r\n      return exists(/databases/$(database)/documents/images/$(imageId));\r\n    }\r\n\r\n    function imageDocData(imageId) {\r\n      return get(/databases/$(database)/documents/images/$(imageId)).data;\r\n    }\r\n\r\n    // Imagem em projeto público com portfólio ativo do dono (métricas /u/:slug/.../image).\r\n    function isPortfolioPublicImage(imageId) {\r\n      return imageExists(imageId)\r\n        && imageDocData(imageId).projectId is string\r\n        && isPublicProject(imageDocData(imageId).projectId)\r\n        && portfolioAvailableForOwner(projectDoc(imageDocData(imageId).projectId).data.userId);\r\n    }\r\n\r\n    // Imagem pública pertencente ao userId do path stats/{userId}/images/{imageId}.\r\n    function isPortfolioPublicImageForOwner(imageId, ownerUserId) {\r\n      return imageExists(imageId)\r\n        && imageDocData(imageId).userId == ownerUserId\r\n        && imageDocData(imageId).projectId is string\r\n        && isPublicProject(imageDocData(imageId).projectId)\r\n        && projectDoc(imageDocData(imageId).projectId).data.userId == ownerUserId\r\n        && portfolioAvailableForOwner(ownerUserId);\r\n    }\r\n\r\n    // ---------- stats (visualizações públicas agrupadas por usuário) ----------\r\n\r\n    match /stats/{userId} {\r\n\r\n      allow get: if isOwner(userId);\r\n      allow list: if false;\r\n\r\n      function isValidStatsRootMutation() {\r\n        let data = request.resource.data;\r\n\r\n        return portfolioAvailableForOwner(userId)\r\n          && data.keys().hasOnly(['portfolioViews', 'updatedAt'])\r\n          && data.portfolioViews is int\r\n          && data.portfolioViews >= 1\r\n          && data.updatedAt is timestamp\r\n          && (\r\n            !exists(/databases/$(database)/documents/stats/$(userId))\r\n              ? data.portfolioViews == 1\r\n              : data.portfolioViews == resource.data.portfolioViews + 1\r\n          );\r\n      }\r\n\r\n      allow create, update: if isValidStatsRootMutation();\r\n      allow delete: if false;\r\n\r\n      match /projects/{projectId} {\r\n\r\n        allow get: if isOwner(userId);\r\n        allow list: if isOwner(userId);\r\n\r\n        function isValidStatsProjectMutation() {\r\n          let data = request.resource.data;\r\n\r\n          return projectExists(projectId)\r\n            && projectDoc(projectId).data.userId == userId\r\n            && isShared(projectDoc(projectId).data.visibility)\r\n            && portfolioAvailableForOwner(userId)\r\n            && data.keys().hasOnly(['views', 'updatedAt'])\r\n            && data.views is int\r\n            && data.views >= 1\r\n            && data.updatedAt is timestamp\r\n            && (\r\n              !exists(/databases/$(database)/documents/stats/$(userId)/projects/$(projectId))\r\n                ? data.views == 1\r\n                : data.views == resource.data.views + 1\r\n            );\r\n        }\r\n\r\n        allow create, update: if isValidStatsProjectMutation();\r\n        allow delete: if false;\r\n      }\r\n\r\n      match /images/{imageId} {\r\n\r\n        allow get: if isOwner(userId);\r\n        allow list: if isOwner(userId);\r\n\r\n        function isValidStatsImageMutation() {\r\n          let data = request.resource.data;\r\n\r\n          return isPortfolioPublicImageForOwner(imageId, userId)\r\n            && data.keys().hasOnly(['views', 'updatedAt'])\r\n            && data.views is int\r\n            && data.views >= 1\r\n            && data.updatedAt is timestamp\r\n            && (\r\n              !exists(/databases/$(database)/documents/stats/$(userId)/images/$(imageId))\r\n                ? data.views == 1\r\n                : data.views == resource.data.views + 1\r\n            );\r\n        }\r\n\r\n        allow create, update: if isValidStatsImageMutation();\r\n        allow delete: if false;\r\n      }\r\n    }\r\n\r\n    // ---------- invoices (Stripe — escrita só via Admin SDK / webhook) ----------\r\n\r\n    match /invoices/{invoiceId} {\r\n\r\n      allow get: if isSignedIn()\r\n        && resource.data.userId == request.auth.uid;\r\n\r\n      allow list: if isSignedIn()\r\n        && resource.data.userId == request.auth.uid;\r\n\r\n      allow create, update, delete: if false;\r\n    }\r\n\r\n    // ---------- emailQueue (transacional — ver docs/resend-email-plan.md) ----------\r\n    // Fase 1: create restrito no cliente; leitura/update/delete só via Admin SDK (Functions).\r\n    // Risco: usuário pode enfileirar e-mails repetidos para si — migrar enqueue para Functions.\r\n\r\n    match /emailQueue/{emailId} {\r\n\r\n      allow get, list: if false;\r\n\r\n      allow create: if isSignedIn() && isValidEmailQueueCreate();\r\n\r\n      allow update, delete: if false;\r\n    }\r\n\r\n    // ---------- slugs ----------\r\n\r\n    match /slugs/{slug} {\r\n\r\n      allow get: if true;\r\n      allow list: if false;\r\n\r\n      allow create: if isSignedIn()\r\n        && request.resource.data.uid == request.auth.uid\r\n        && request.resource.data.type == 'user'\r\n        && request.resource.data.createdAt is timestamp\r\n        && isValidSlug(slug);\r\n\r\n      allow update: if false;\r\n\r\n      allow delete: if isSignedIn()\r\n        && resource.data.uid == request.auth.uid;\r\n    }\r\n\r\n    // ---------- publicProfiles (dados públicos do portfólio) ----------\r\n\r\n    match /publicProfiles/{userId} {\r\n\r\n      allow get: if isOwner(userId)\r\n        || resource.data.portfolioAvailable == true;\r\n\r\n      allow list: if false;\r\n\r\n      allow create: if isOwner(userId)\r\n        && request.resource.data.uid == userId;\r\n\r\n      allow update: if isOwner(userId)\r\n        && request.resource.data.uid == userId;\r\n\r\n      allow delete: if isOwner(userId);\r\n    }\r\n\r\n    // ---------- workspaces (fundação multiusuário — Sprint Multiuser Foundation 1) ----------\r\n\r\n    function workspaceExists(workspaceId) {\r\n      return exists(/databases/$(database)/documents/workspaces/$(workspaceId));\r\n    }\r\n\r\n    function workspaceDoc(workspaceId) {\r\n      return get(/databases/$(database)/documents/workspaces/$(workspaceId));\r\n    }\r\n\r\n    function isWorkspaceMember(workspaceId) {\r\n      return isSignedIn()\r\n        && workspaceExists(workspaceId)\r\n        && exists(/databases/$(database)/documents/workspaces/$(workspaceId)/members/$(request.auth.uid))\r\n        && get(/databases/$(database)/documents/workspaces/$(workspaceId)/members/$(request.auth.uid)).data.status == 'active';\r\n    }\r\n\r\n    function isWorkspaceOwner(workspaceId) {\r\n      return isSignedIn()\r\n        && workspaceExists(workspaceId)\r\n        && workspaceDoc(workspaceId).data.ownerId == request.auth.uid;\r\n    }\r\n\r\n    // Bootstrap do workspace pessoal em batch (workspace + member na mesma operação).\r\n    // exists()/get() no workspace pai ainda não enxergam writes anteriores do batch.\r\n    function isPersonalWorkspaceMemberBootstrap(workspaceId, memberId) {\r\n      return isSignedIn()\r\n        && workspaceId == request.auth.uid\r\n        && memberId == request.auth.uid\r\n        && request.resource.data.userId == memberId\r\n        && request.resource.data.role == 'owner'\r\n        && request.resource.data.status == 'active'\r\n        && request.resource.data.createdAt is timestamp\r\n        && request.resource.data.updatedAt is timestamp;\r\n    }\r\n\r\n    match /workspaces/{workspaceId} {\r\n\r\n      allow get: if isWorkspaceMember(workspaceId);\r\n      allow list: if false;\r\n\r\n      allow create: if isSignedIn()\r\n        && request.resource.data.ownerId == request.auth.uid\r\n        && workspaceId == request.auth.uid\r\n        && request.resource.data.type == 'personal'\r\n        && request.resource.data.planId == 'starter'\r\n        && request.resource.data.name is string\r\n        && request.resource.data.createdAt is timestamp\r\n        && request.resource.data.updatedAt is timestamp;\r\n\r\n      allow update: if isWorkspaceOwner(workspaceId)\r\n        && request.resource.data.ownerId == resource.data.ownerId\r\n        && request.resource.data.type == resource.data.type\r\n        && request.resource.data.planId is string\r\n        && request.resource.data.name is string\r\n        && request.resource.data.updatedAt is timestamp;\r\n\r\n      allow delete: if false;\r\n\r\n      match /members/{memberId} {\r\n\r\n        allow get: if isWorkspaceMember(workspaceId);\r\n        allow list: if isWorkspaceMember(workspaceId);\r\n\r\n        allow create: if isWorkspaceOwner(workspaceId)\r\n          && request.resource.data.userId == memberId\r\n          && request.resource.data.role == 'owner'\r\n          && request.resource.data.status == 'active'\r\n          && request.resource.data.createdAt is timestamp\r\n          && request.resource.data.updatedAt is timestamp;\r\n\r\n        allow update: if isWorkspaceOwner(workspaceId)\r\n          && request.resource.data.userId == resource.data.userId\r\n          && request.resource.data.role is string\r\n          && request.resource.data.status is string\r\n          && request.resource.data.updatedAt is timestamp;\r\n\r\n        allow delete: if isWorkspaceOwner(workspaceId);\r\n      }\r\n    }\r\n\r\n    // ---------- users (dados privados — owner only) ----------\r\n\r\n    match /users/{userId} {\r\n\r\n      allow get: if isOwner(userId);\r\n      allow list: if false;\r\n\r\n      allow create: if isOwner(userId);\r\n      allow update: if isOwner(userId);\r\n      allow delete: if isOwner(userId);\r\n    }\r\n\r\n    // ---------- projects ----------\r\n\r\n    match /projects/{projectId} {\r\n\r\n      allow get: if isOwner(resource.data.userId)\r\n                  || isShared(resource.data.visibility);\r\n\r\n      allow list: if\r\n        (isSignedIn() && resource.data.userId == request.auth.uid)\r\n        || (\r\n          isShared(resource.data.visibility)\r\n          && portfolioAvailableForOwner(resource.data.userId)\r\n        );\r\n\r\n      allow create: if isSignedIn()\r\n        && request.resource.data.userId == request.auth.uid\r\n        && request.resource.data.title is string\r\n        && request.resource.data.description is string\r\n        && request.resource.data.coverImage is string\r\n        && isValidVisibility(request.resource.data.visibility);\r\n\r\n      allow update: if isOwner(resource.data.userId)\r\n        && request.resource.data.userId == resource.data.userId\r\n        && request.resource.data.title is string\r\n        && request.resource.data.description is string\r\n        && request.resource.data.coverImage is string\r\n        && isValidVisibility(request.resource.data.visibility);\r\n\r\n      allow delete: if isOwner(resource.data.userId);\r\n    }\r\n\r\n    // ---------- images ----------\r\n\r\n    match /images/{imageId} {\r\n\r\n      allow get: if isOwner(resource.data.userId)\r\n                  || imageIsPubliclyReadable(resource.data);\r\n\r\n      // Owner: where('userId', '==', authUid) [+ projectId].\r\n      // Público: where('projectId', '==', X) — permitido só se projeto X é shared/public.\r\n      allow list: if\r\n        (isSignedIn() && resource.data.userId == request.auth.uid)\r\n        || imageListableInPublicProject(resource.data);\r\n\r\n      allow create: if isSignedIn()\r\n        && request.resource.data.userId == request.auth.uid\r\n        && request.resource.data.title is string\r\n        && request.resource.data.previewUrl is string\r\n        && request.resource.data.originalUrl is string\r\n        && request.resource.data.sizeBytes is number\r\n        && isValidVisibility(request.resource.data.visibility)\r\n        && (\r\n          !request.resource.data.keys().hasAny(['projectId'])\r\n          || request.resource.data.projectId == null\r\n          || (\r\n            request.resource.data.projectId is string\r\n            && projectBelongsToCaller(request.resource.data.projectId)\r\n          )\r\n        )\r\n        && (\r\n          !request.resource.data.keys().hasAny(['projectVisibility'])\r\n          || request.resource.data.projectVisibility == null\r\n          || isValidVisibility(request.resource.data.projectVisibility)\r\n        );\r\n\r\n      allow update: if isOwner(resource.data.userId)\r\n        && request.resource.data.userId == resource.data.userId\r\n        && isValidVisibility(request.resource.data.visibility)\r\n        && (\r\n          !request.resource.data.keys().hasAny(['projectId'])\r\n          || request.resource.data.projectId == null\r\n          || (\r\n            request.resource.data.projectId is string\r\n            && projectBelongsToCaller(request.resource.data.projectId)\r\n          )\r\n        )\r\n        && (\r\n          !request.resource.data.keys().hasAny(['projectVisibility'])\r\n          || request.resource.data.projectVisibility == null\r\n          || isValidVisibility(request.resource.data.projectVisibility)\r\n        );\r\n\r\n      allow delete: if isOwner(resource.data.userId);\r\n\r\n      // ---------- hotspots (subcoleção) ----------\r\n\r\n      match /hotspots/{hotspotId} {\r\n\r\n        function parentImage() {\r\n          return get(/databases/$(database)/documents/images/$(imageId));\r\n        }\r\n\r\n        function parentImageIsPublic() {\r\n          return imageIsPubliclyReadable(parentImage().data);\r\n        }\r\n\r\n        allow get: if isOwner(parentImage().data.userId)\r\n                    || parentImageIsPublic();\r\n\r\n        allow list: if isOwner(parentImage().data.userId)\r\n                     || parentImageIsPublic();\r\n\r\n        allow create: if isOwner(parentImage().data.userId)\r\n          && request.resource.data.userId == request.auth.uid\r\n          && request.resource.data.imageId == imageId\r\n          && request.resource.data.pitch is number\r\n          && request.resource.data.yaw is number\r\n          && request.resource.data.createdAt is timestamp\r\n          && request.resource.data.updatedAt is timestamp\r\n          && (\r\n            !request.resource.data.keys().hasAny(['projectId'])\r\n            || request.resource.data.projectId is string\r\n          )\r\n          && (\r\n            (\r\n              request.resource.data.type == 'info'\r\n              && request.resource.data.title is string\r\n              && request.resource.data.description is string\r\n            )\r\n            || (\r\n              request.resource.data.type == 'scene'\r\n              && request.resource.data.targetImageId is string\r\n            )\r\n          );\r\n\r\n        allow update: if isOwner(parentImage().data.userId)\r\n          && resource.data.userId == request.auth.uid\r\n          && request.resource.data.userId == resource.data.userId\r\n          && request.resource.data.imageId == imageId\r\n          && request.resource.data.pitch == resource.data.pitch\r\n          && request.resource.data.yaw == resource.data.yaw\r\n          && (\r\n            (\r\n              resource.data.type == 'info'\r\n              && request.resource.data.type == 'info'\r\n              && request.resource.data.title is string\r\n              && request.resource.data.description is string\r\n            )\r\n            || (\r\n              resource.data.type == 'scene'\r\n              && request.resource.data.type == 'scene'\r\n              && request.resource.data.targetImageId is string\r\n            )\r\n          );\r\n\r\n        allow delete: if isOwner(parentImage().data.userId)\r\n          && resource.data.userId == request.auth.uid;\r\n      }\r\n    }\r\n  }\r\n}\r\n"}]}}
