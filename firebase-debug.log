[debug] [2026-08-04T21:57:42.699Z] >>> [apiv2][body] PUT http://127.0.0.1:8080/emulator/v1/projects/fivi360:securityRules {"ignore_errors":true,"rules":{"files":[{"name":"security.rules","content":"rules_version = '2';\r\n\r\n// --------------------------------------------------------------------------\r\n// FIVI360 — Firestore Security Rules (RC-P0.5 — Firestore Rules Hardening)\r\n//\r\n// Coleções:\r\n//   users/{userId}              — dados privados (plano, billing, legal)\r\n//   publicProfiles/{userId}     — dados públicos do portfólio\r\n//   workspaces/{workspaceId}    — fundação multiusuário (workspace pessoal)\r\n//   workspaces/{workspaceId}/members/{uid}\r\n//   slugs/{slug}                — resolução /u/:slug\r\n//   projects/{projectId}\r\n//   images/{imageId}\r\n//   images/{imageId}/hotspots/{hotspotId}\r\n//   stats/{userId}                  — contadores agregados de portfólio\r\n//   stats/{userId}/projects/{projectId} — contadores de projeto público\r\n//   stats/{userId}/images/{imageId}     — contadores de imagem 360 pública\r\n//   invoices/{invoiceId}          — faturas Stripe (escrita via webhook / Admin SDK)\r\n//   emailQueue/{emailId}          — fila de e-mails transacionais (Resend)\r\n//\r\n// Admin SDK / Cloud Functions ignoram estas rules e continuam gravando\r\n// plan, billing, portfolioAvailable, emailVerified*, etc.\r\n//\r\n// Split get vs list: queries precisam provar estaticamente os predicados\r\n// usados em allow list. Ver docs/security-rules-notes.md.\r\n// --------------------------------------------------------------------------\r\n\r\nservice cloud.firestore {\r\n  match /databases/{database}/documents {\r\n\r\n    // ---------- helpers ----------\r\n\r\n    function isSignedIn() {\r\n      return request.auth != null;\r\n    }\r\n\r\n    function isOwner(userId) {\r\n      return isSignedIn() && request.auth.uid == userId;\r\n    }\r\n\r\n    function isValidVisibility(value) {\r\n      return value in ['private', 'shared', 'public'];\r\n    }\r\n\r\n    function isShared(value) {\r\n      return value == 'shared' || value == 'public';\r\n    }\r\n\r\n    function isValidEmbedSettings(settings) {\r\n      return settings is map\r\n        && settings.keys().hasAll([\r\n          'enabled',\r\n          'initialImageId',\r\n          'allowFullscreen',\r\n          'allowNavigation',\r\n          'showBranding',\r\n          'updatedAt'\r\n        ])\r\n        && settings.enabled is bool\r\n        && (settings.initialImageId == null || settings.initialImageId is string)\r\n        && settings.allowFullscreen is bool\r\n        && settings.allowNavigation is bool\r\n        && settings.showBranding == true\r\n        && settings.updatedAt is timestamp;\r\n    }\r\n\r\n    function embedSettingsUnchangedOrValid() {\r\n      return (!('embedSettings' in request.resource.data)\r\n          && !('embedSettings' in resource.data))\r\n        || (\r\n          'embedSettings' in request.resource.data\r\n          && 'embedSettings' in resource.data\r\n          && request.resource.data.embedSettings == resource.data.embedSettings\r\n        )\r\n        || (\r\n          'embedSettings' in request.resource.data\r\n          && isValidEmbedSettings(request.resource.data.embedSettings)\r\n        );\r\n    }\r\n\r\n    function projectDoc(projectId) {\r\n      return get(/databases/$(database)/documents/projects/$(projectId));\r\n    }\r\n\r\n    function projectExists(projectId) {\r\n      return exists(/databases/$(database)/documents/projects/$(projectId));\r\n    }\r\n\r\n    function projectBelongsToCaller(projectId) {\r\n      return projectId == null\r\n        || (\r\n          projectExists(projectId)\r\n          && projectDoc(projectId).data.userId == request.auth.uid\r\n        );\r\n    }\r\n\r\n    function isValidSlug(slug) {\r\n      return slug.matches('^[a-z0-9]+(-[a-z0-9]+)*$');\r\n    }\r\n\r\n    function isAllowedClientEmailType(type) {\r\n      return type in ['welcome', 'verify_email', 'billing_upgrade_requested'];\r\n    }\r\n\r\n    function isValidEmailQueueCreate() {\r\n      return request.resource.data.keys().hasAll(['type', 'to', 'userId', 'payload', 'status', 'createdAt'])\r\n        && request.resource.data.userId == request.auth.uid\r\n        && request.resource.data.to == request.auth.token.email\r\n        && request.resource.data.status == 'pending'\r\n        && isAllowedClientEmailType(request.resource.data.type)\r\n        && request.resource.data.to is string\r\n        && request.resource.data.payload is map\r\n        && request.resource.data.createdAt is timestamp\r\n        && !request.resource.data.keys().hasAny(['sentAt', 'resendId', 'error']);\r\n    }\r\n\r\n    // ---------- RC-P0.5: users / publicProfiles field hardening ----------\r\n\r\n    // Bootstrap billing mínimo (espelha DEFAULT_BILLING — Stripe / free).\r\n    // Após o create, billing é imutável pelo cliente (Stripe/webhook via Admin SDK).\r\n    function isStarterBootstrapBilling(billing) {\r\n      return billing is map\r\n        && billing.keys().hasOnly([\r\n          'provider',\r\n          'subscriptionStatus'\r\n        ])\r\n        && billing.provider == 'stripe'\r\n        && billing.subscriptionStatus == 'free';\r\n    }\r\n\r\n    function isValidLegalConsent(consent) {\r\n      return consent is map\r\n        && consent.keys().hasOnly([\r\n          'termsAccepted',\r\n          'privacyAccepted',\r\n          'termsVersion',\r\n          'privacyVersion',\r\n          'acceptedAt',\r\n          'acceptedSource'\r\n        ])\r\n        && consent.termsAccepted == true\r\n        && consent.privacyAccepted == true\r\n        && consent.termsVersion is string\r\n        && consent.privacyVersion is string\r\n        && consent.acceptedAt is timestamp\r\n        && consent.acceptedSource in ['signup', 'modal_existing_user'];\r\n    }\r\n\r\n    // RC-MARKETING-CONSENT-1 — preferências de marketing (opt-in explícito).\r\n    function isValidMarketingPreferences(prefs) {\r\n      return prefs is map\r\n        && prefs.keys().hasOnly([\r\n          'enabled',\r\n          'productUpdates',\r\n          'offers',\r\n          'tips',\r\n          'newsletter',\r\n          'research',\r\n          'consentVersion',\r\n          'consentSource',\r\n          'consentedAt',\r\n          'revokedAt',\r\n          'updatedAt'\r\n        ])\r\n        && prefs.enabled is bool\r\n        && prefs.productUpdates is bool\r\n        && prefs.offers is bool\r\n        && prefs.tips is bool\r\n        && prefs.newsletter is bool\r\n        && prefs.research is bool\r\n        && (prefs.consentVersion == null || prefs.consentVersion is string)\r\n        && (prefs.consentSource == null || prefs.consentSource is string)\r\n        && (prefs.consentedAt == null || prefs.consentedAt is timestamp)\r\n        && (prefs.revokedAt == null || prefs.revokedAt is timestamp)\r\n        && prefs.updatedAt is timestamp\r\n        && (\r\n          prefs.enabled == false\r\n          || prefs.consentedAt is timestamp\r\n        );\r\n    }\r\n\r\n    function isValidSocialLinks(links) {\r\n      return links is map\r\n        && links.keys().hasOnly([\r\n          'website',\r\n          'instagram',\r\n          'youtube',\r\n          'linkedin',\r\n          'whatsapp'\r\n        ])\r\n        && links.website is string\r\n        && links.instagram is string\r\n        && links.youtube is string\r\n        && links.linkedin is string\r\n        && links.whatsapp is string;\r\n    }\r\n\r\n    function userCreateFieldsAreValid(userId) {\r\n      let data = request.resource.data;\r\n\r\n      return data.keys().hasOnly([\r\n          'displayName',\r\n          'email',\r\n          'plan',\r\n          'billing',\r\n          'defaultWorkspaceId',\r\n          'activeWorkspaceId',\r\n          'welcomeEmailQueuedAt',\r\n          'createdAt',\r\n          'updatedAt',\r\n          'legalConsent',\r\n          'marketingPreferences'\r\n        ])\r\n        && data.displayName is string\r\n        && data.email is string\r\n        && data.plan == 'starter'\r\n        && isStarterBootstrapBilling(data.billing)\r\n        && data.defaultWorkspaceId is string\r\n        && data.defaultWorkspaceId == userId\r\n        && data.activeWorkspaceId is string\r\n        && data.activeWorkspaceId == userId\r\n        && data.createdAt is timestamp\r\n        && data.updatedAt is timestamp\r\n        && (\r\n          !data.keys().hasAny(['welcomeEmailQueuedAt'])\r\n          || data.welcomeEmailQueuedAt == null\r\n        )\r\n        && (\r\n          !data.keys().hasAny(['legalConsent'])\r\n          || isValidLegalConsent(data.legalConsent)\r\n        )\r\n        && (\r\n          !data.keys().hasAny(['marketingPreferences'])\r\n          || isValidMarketingPreferences(data.marketingPreferences)\r\n        );\r\n    }\r\n\r\n    function userUpdateFieldsAreValid() {\r\n      let affected = request.resource.data.diff(resource.data).affectedKeys();\r\n      let data = request.resource.data;\r\n\r\n      // Allowlist mínima — qualquer outro campo (plan, billing, admin, etc.) é negado.\r\n      return affected.hasOnly([\r\n          'displayName',\r\n          'updatedAt',\r\n          'legalConsent',\r\n          'welcomeEmailQueuedAt',\r\n          'marketingPreferences'\r\n        ])\r\n        && data.updatedAt is timestamp\r\n        && (\r\n          !affected.hasAny(['displayName'])\r\n          || data.displayName is string\r\n        )\r\n        && (\r\n          !affected.hasAny(['legalConsent'])\r\n          || isValidLegalConsent(data.legalConsent)\r\n        )\r\n        && (\r\n          !affected.hasAny(['welcomeEmailQueuedAt'])\r\n          || data.welcomeEmailQueuedAt == null\r\n          || data.welcomeEmailQueuedAt is timestamp\r\n        )\r\n        && (\r\n          !affected.hasAny(['marketingPreferences'])\r\n          || isValidMarketingPreferences(data.marketingPreferences)\r\n        );\r\n    }\r\n\r\n    // portfolioAvailable: entitlement comercial — cliente nunca promove a true.\r\n    // Demote para false é permitido (ocultar portfólio). Promote só via Admin SDK.\r\n    function publicEntitlementFieldsUnchanged() {\r\n      let affected = request.resource.data.diff(resource.data).affectedKeys();\r\n\r\n      return !affected.hasAny(['portfolioAvailable'])\r\n        || request.resource.data.portfolioAvailable == false;\r\n    }\r\n\r\n    function publicProfileCreateFieldsAreValid(userId) {\r\n      let data = request.resource.data;\r\n\r\n      return data.keys().hasOnly([\r\n          'uid',\r\n          'slug',\r\n          'portfolioEnabled',\r\n          'portfolioAvailable',\r\n          'displayName',\r\n          'companyName',\r\n          'companyLogo',\r\n          'bio',\r\n          'socialLinks',\r\n          'createdAt',\r\n          'updatedAt'\r\n        ])\r\n        && data.uid == userId\r\n        && data.slug is string\r\n        && data.portfolioEnabled is bool\r\n        && data.portfolioEnabled == false\r\n        && data.portfolioAvailable is bool\r\n        && data.portfolioAvailable == false\r\n        && data.displayName is string\r\n        && data.companyName is string\r\n        && data.companyLogo is string\r\n        && data.bio is string\r\n        && isValidSocialLinks(data.socialLinks)\r\n        && data.createdAt is timestamp\r\n        && data.updatedAt is timestamp;\r\n    }\r\n\r\n    function publicProfileUpdateFieldsAreValid(userId) {\r\n      let affected = request.resource.data.diff(resource.data).affectedKeys();\r\n      let data = request.resource.data;\r\n\r\n      return data.uid == userId\r\n        && data.uid == resource.data.uid\r\n        && publicEntitlementFieldsUnchanged()\r\n        && !affected.hasAny([\r\n          'plan',\r\n          'planId',\r\n          'billing',\r\n          'subscription',\r\n          'subscriptionStatus',\r\n          'featureFlags',\r\n          'premiumFeatures',\r\n          'portfolioEnabledByPlan',\r\n          'analyticsAvailable',\r\n          'hotspotsAvailable',\r\n          'whiteLabelAvailable',\r\n          'customDomainAvailable',\r\n          'role',\r\n          'admin',\r\n          'isAdmin',\r\n          'permissions',\r\n          'claims',\r\n          'createdAt'\r\n        ])\r\n        && affected.hasOnly([\r\n          'uid',\r\n          'displayName',\r\n          'companyName',\r\n          'companyLogo',\r\n          'bio',\r\n          'slug',\r\n          'portfolioEnabled',\r\n          'portfolioAvailable',\r\n          'socialLinks',\r\n          'updatedAt'\r\n        ])\r\n        && (\r\n          !affected.hasAny(['portfolioAvailable'])\r\n          || data.portfolioAvailable == false\r\n        )\r\n        && (\r\n          !affected.hasAny(['displayName'])\r\n          || data.displayName is string\r\n        )\r\n        && (\r\n          !affected.hasAny(['companyName'])\r\n          || data.companyName is string\r\n        )\r\n        && (\r\n          !affected.hasAny(['companyLogo'])\r\n          || data.companyLogo is string\r\n        )\r\n        && (\r\n          !affected.hasAny(['bio'])\r\n          || data.bio is string\r\n        )\r\n        && (\r\n          !affected.hasAny(['slug'])\r\n          || data.slug is string\r\n        )\r\n        && (\r\n          !affected.hasAny(['portfolioEnabled'])\r\n          || data.portfolioEnabled is bool\r\n        )\r\n        && (\r\n          !affected.hasAny(['socialLinks'])\r\n          || isValidSocialLinks(data.socialLinks)\r\n        )\r\n        && (\r\n          !affected.hasAny(['updatedAt'])\r\n          || data.updatedAt is timestamp\r\n        );\r\n    }\r\n\r\n    // Portfólio /u/:slug — listagem de projetos públicos exige portfolioAvailable.\r\n    // get individual de projeto shared/public (ex.: /share/project) não usa este helper.\r\n    function portfolioAvailableForOwner(userId) {\r\n      return exists(/databases/$(database)/documents/publicProfiles/$(userId))\r\n        && get(/databases/$(database)/documents/publicProfiles/$(userId)).data.portfolioAvailable == true;\r\n    }\r\n\r\n    // Projeto shared/public — usado em get/list de imagens por projectId.\r\n    function isPublicProject(projectId) {\r\n      return projectExists(projectId)\r\n        && isShared(projectDoc(projectId).data.visibility);\r\n    }\r\n\r\n    // Get individual: imagem shared OU projeto pai shared/public.\r\n    function imageIsPubliclyReadable(imageData) {\r\n      return isShared(imageData.visibility)\r\n        || (\r\n          imageData.projectId != null\r\n          && isPublicProject(imageData.projectId)\r\n        );\r\n    }\r\n\r\n    // List por projectId: só quando o projeto pai é shared/public.\r\n    // Imagens shared em projeto private são acessíveis via get, não via list.\r\n    function imageListableInPublicProject(imageData) {\r\n      return imageData.projectId != null\r\n        && isPublicProject(imageData.projectId);\r\n    }\r\n\r\n    function imageExists(imageId) {\r\n      return exists(/databases/$(database)/documents/images/$(imageId));\r\n    }\r\n\r\n    function imageDocData(imageId) {\r\n      return get(/databases/$(database)/documents/images/$(imageId)).data;\r\n    }\r\n\r\n    // Imagem em projeto público com portfólio ativo do dono (métricas /u/:slug/.../image).\r\n    function isPortfolioPublicImage(imageId) {\r\n      return imageExists(imageId)\r\n        && imageDocData(imageId).projectId is string\r\n        && isPublicProject(imageDocData(imageId).projectId)\r\n        && portfolioAvailableForOwner(projectDoc(imageDocData(imageId).projectId).data.userId);\r\n    }\r\n\r\n    // Imagem pública pertencente ao userId do path stats/{userId}/images/{imageId}.\r\n    function isPortfolioPublicImageForOwner(imageId, ownerUserId) {\r\n      return imageExists(imageId)\r\n        && imageDocData(imageId).userId == ownerUserId\r\n        && imageDocData(imageId).projectId is string\r\n        && isPublicProject(imageDocData(imageId).projectId)\r\n        && projectDoc(imageDocData(imageId).projectId).data.userId == ownerUserId\r\n        && portfolioAvailableForOwner(ownerUserId);\r\n    }\r\n\r\n    // ---------- stats (visualizações públicas agrupadas por usuário) ----------\r\n\r\n    match /stats/{userId} {\r\n\r\n      allow get: if isOwner(userId);\r\n      allow list: if false;\r\n\r\n      function isValidStatsRootMutation() {\r\n        let data = request.resource.data;\r\n\r\n        return portfolioAvailableForOwner(userId)\r\n          && data.keys().hasOnly(['portfolioViews', 'updatedAt'])\r\n          && data.portfolioViews is int\r\n          && data.portfolioViews >= 1\r\n          && data.updatedAt is timestamp\r\n          && (\r\n            !exists(/databases/$(database)/documents/stats/$(userId))\r\n              ? data.portfolioViews == 1\r\n              : data.portfolioViews == resource.data.portfolioViews + 1\r\n          );\r\n      }\r\n\r\n      allow create, update: if isValidStatsRootMutation();\r\n      allow delete: if false;\r\n\r\n      match /projects/{projectId} {\r\n\r\n        allow get: if isOwner(userId);\r\n        allow list: if isOwner(userId);\r\n\r\n        function isValidStatsProjectMutation() {\r\n          let data = request.resource.data;\r\n\r\n          return projectExists(projectId)\r\n            && projectDoc(projectId).data.userId == userId\r\n            && isShared(projectDoc(projectId).data.visibility)\r\n            && portfolioAvailableForOwner(userId)\r\n            && data.keys().hasOnly(['views', 'updatedAt'])\r\n            && data.views is int\r\n            && data.views >= 1\r\n            && data.updatedAt is timestamp\r\n            && (\r\n              !exists(/databases/$(database)/documents/stats/$(userId)/projects/$(projectId))\r\n                ? data.views == 1\r\n                : data.views == resource.data.views + 1\r\n            );\r\n        }\r\n\r\n        allow create, update: if isValidStatsProjectMutation();\r\n        allow delete: if false;\r\n      }\r\n\r\n      match /images/{imageId} {\r\n\r\n        allow get: if isOwner(userId);\r\n        allow list: if isOwner(userId);\r\n\r\n        function isValidStatsImageMutation() {\r\n          let data = request.resource.data;\r\n\r\n          return isPortfolioPublicImageForOwner(imageId, userId)\r\n            && data.keys().hasOnly(['views', 'updatedAt'])\r\n            && data.views is int\r\n            && data.views >= 1\r\n            && data.updatedAt is timestamp\r\n            && (\r\n              !exists(/databases/$(database)/documents/stats/$(userId)/images/$(imageId))\r\n                ? data.views == 1\r\n                : data.views == resource.data.views + 1\r\n            );\r\n        }\r\n\r\n        allow create, update: if isValidStatsImageMutation();\r\n        // Dono pode limpar stats órfãos na exclusão cascade da imagem (RC-P0.6).\r\n        allow delete: if isOwner(userId);\r\n      }\r\n    }\r\n\r\n    // ---------- invoices (Stripe — escrita só via Admin SDK / webhook) ----------\r\n\r\n    match /invoices/{invoiceId} {\r\n\r\n      allow get: if isSignedIn()\r\n        && resource.data.userId == request.auth.uid;\r\n\r\n      allow list: if isSignedIn()\r\n        && resource.data.userId == request.auth.uid;\r\n\r\n      allow create, update, delete: if false;\r\n    }\r\n\r\n    // ---------- emailQueue (transacional — ver docs/resend-email-plan.md) ----------\r\n    // Fase 1: create restrito no cliente; leitura/update/delete só via Admin SDK (Functions).\r\n    // Risco: usuário pode enfileirar e-mails repetidos para si — migrar enqueue para Functions.\r\n\r\n    match /emailQueue/{emailId} {\r\n\r\n      allow get, list: if false;\r\n\r\n      allow create: if isSignedIn() && isValidEmailQueueCreate();\r\n\r\n      allow update, delete: if false;\r\n    }\r\n\r\n    // ---------- slugs ----------\r\n\r\n    match /slugs/{slug} {\r\n\r\n      allow get: if true;\r\n      allow list: if false;\r\n\r\n      allow create: if isSignedIn()\r\n        && request.resource.data.uid == request.auth.uid\r\n        && request.resource.data.type == 'user'\r\n        && request.resource.data.createdAt is timestamp\r\n        && isValidSlug(slug);\r\n\r\n      allow update: if false;\r\n\r\n      allow delete: if isSignedIn()\r\n        && resource.data.uid == request.auth.uid;\r\n    }\r\n\r\n    // ---------- publicProfiles (dados públicos do portfólio) ----------\r\n    // portfolioAvailable: SERVER_ONLY promote (Admin SDK / syncPublicPortfolioAvailability).\r\n    // Cliente pode demote para false ao desativar o portfólio.\r\n\r\n    match /publicProfiles/{userId} {\r\n\r\n      allow get: if isOwner(userId)\r\n        || resource.data.portfolioAvailable == true;\r\n\r\n      allow list: if false;\r\n\r\n      allow create: if isOwner(userId)\r\n        && publicProfileCreateFieldsAreValid(userId);\r\n\r\n      allow update: if isOwner(userId)\r\n        && publicProfileUpdateFieldsAreValid(userId);\r\n\r\n      allow delete: if false;\r\n    }\r\n\r\n    // ---------- workspaces (fundação multiusuário — Sprint Multiuser Foundation 1) ----------\r\n\r\n    function workspaceExists(workspaceId) {\r\n      return exists(/databases/$(database)/documents/workspaces/$(workspaceId));\r\n    }\r\n\r\n    function workspaceDoc(workspaceId) {\r\n      return get(/databases/$(database)/documents/workspaces/$(workspaceId));\r\n    }\r\n\r\n    function isWorkspaceMember(workspaceId) {\r\n      return isSignedIn()\r\n        && workspaceExists(workspaceId)\r\n        && exists(/databases/$(database)/documents/workspaces/$(workspaceId)/members/$(request.auth.uid))\r\n        && get(/databases/$(database)/documents/workspaces/$(workspaceId)/members/$(request.auth.uid)).data.status == 'active';\r\n    }\r\n\r\n    function isWorkspaceOwner(workspaceId) {\r\n      return isSignedIn()\r\n        && workspaceExists(workspaceId)\r\n        && workspaceDoc(workspaceId).data.ownerId == request.auth.uid;\r\n    }\r\n\r\n    // Bootstrap do workspace pessoal em batch (workspace + member na mesma operação).\r\n    // exists()/get() no workspace pai ainda não enxergam writes anteriores do batch.\r\n    function isPersonalWorkspaceMemberBootstrap(workspaceId, memberId) {\r\n      return isSignedIn()\r\n        && workspaceId == request.auth.uid\r\n        && memberId == request.auth.uid\r\n        && request.resource.data.userId == memberId\r\n        && request.resource.data.role == 'owner'\r\n        && request.resource.data.status == 'active'\r\n        && request.resource.data.createdAt is timestamp\r\n        && request.resource.data.updatedAt is timestamp;\r\n    }\r\n\r\n    match /workspaces/{workspaceId} {\r\n\r\n      allow get: if isWorkspaceMember(workspaceId);\r\n      allow list: if false;\r\n\r\n      allow create: if isSignedIn()\r\n        && request.resource.data.ownerId == request.auth.uid\r\n        && workspaceId == request.auth.uid\r\n        && request.resource.data.type == 'personal'\r\n        && request.resource.data.planId == 'starter'\r\n        && request.resource.data.name is string\r\n        && request.resource.data.createdAt is timestamp\r\n        && request.resource.data.updatedAt is timestamp;\r\n\r\n      allow update: if isWorkspaceOwner(workspaceId)\r\n        && request.resource.data.ownerId == resource.data.ownerId\r\n        && request.resource.data.type == resource.data.type\r\n        // RC-P0.5A: planId não é fonte de entitlement, mas não pode ser alterado pelo cliente.\r\n        && request.resource.data.planId == resource.data.planId\r\n        && request.resource.data.name is string\r\n        && request.resource.data.updatedAt is timestamp;\r\n\r\n      allow delete: if false;\r\n\r\n      match /members/{memberId} {\r\n\r\n        allow get: if isWorkspaceMember(workspaceId);\r\n        allow list: if isWorkspaceMember(workspaceId);\r\n\r\n        allow create: if (\r\n          isWorkspaceOwner(workspaceId)\r\n          || isPersonalWorkspaceMemberBootstrap(workspaceId, memberId)\r\n        )\r\n          && request.resource.data.userId == memberId\r\n          && request.resource.data.role == 'owner'\r\n          && request.resource.data.status == 'active'\r\n          && request.resource.data.createdAt is timestamp\r\n          && request.resource.data.updatedAt is timestamp;\r\n\r\n        allow update: if isWorkspaceOwner(workspaceId)\r\n          && request.resource.data.userId == resource.data.userId\r\n          && request.resource.data.role is string\r\n          && request.resource.data.status is string\r\n          && request.resource.data.updatedAt is timestamp;\r\n\r\n        allow delete: if isWorkspaceOwner(workspaceId);\r\n      }\r\n    }\r\n\r\n    // ---------- users (dados privados — owner only) ----------\r\n    // plan / billing: bootstrap starter no create; updates só via Admin SDK.\r\n    // Allowlist de update: displayName, legalConsent, welcomeEmailQueuedAt,\r\n    // marketingPreferences, updatedAt.\r\n\r\n    match /users/{userId} {\r\n\r\n      allow get: if isOwner(userId);\r\n      allow list: if false;\r\n\r\n      allow create: if isOwner(userId)\r\n        && userCreateFieldsAreValid(userId);\r\n\r\n      allow update: if isOwner(userId)\r\n        && userUpdateFieldsAreValid();\r\n\r\n      allow delete: if false;\r\n    }\r\n\r\n    // ---------- projects ----------\r\n\r\n    match /projects/{projectId} {\r\n\r\n      allow get: if isOwner(resource.data.userId)\r\n                  || isShared(resource.data.visibility);\r\n\r\n      allow list: if\r\n        (isSignedIn() && resource.data.userId == request.auth.uid)\r\n        || (\r\n          isShared(resource.data.visibility)\r\n          && portfolioAvailableForOwner(resource.data.userId)\r\n        );\r\n\r\n      allow create: if isSignedIn()\r\n        && request.resource.data.userId == request.auth.uid\r\n        && request.resource.data.title is string\r\n        && request.resource.data.description is string\r\n        && request.resource.data.coverImage is string\r\n        && isValidVisibility(request.resource.data.visibility);\r\n\r\n      allow update: if isOwner(resource.data.userId)\r\n        && request.resource.data.userId == resource.data.userId\r\n        && request.resource.data.title is string\r\n        && request.resource.data.description is string\r\n        && request.resource.data.coverImage is string\r\n        && isValidVisibility(request.resource.data.visibility)\r\n        && embedSettingsUnchangedOrValid();\r\n\r\n      allow delete: if isOwner(resource.data.userId);\r\n    }\r\n\r\n    // ---------- images ----------\r\n\r\n    match /images/{imageId} {\r\n\r\n      allow get: if isOwner(resource.data.userId)\r\n                  || imageIsPubliclyReadable(resource.data);\r\n\r\n      // Owner: where('userId', '==', authUid) [+ projectId].\r\n      // Público: where('projectId', '==', X) — permitido só se projeto X é shared/public.\r\n      allow list: if\r\n        (isSignedIn() && resource.data.userId == request.auth.uid)\r\n        || imageListableInPublicProject(resource.data);\r\n\r\n      allow create: if isSignedIn()\r\n        && request.resource.data.userId == request.auth.uid\r\n        && request.resource.data.title is string\r\n        && request.resource.data.previewUrl is string\r\n        && request.resource.data.originalUrl is string\r\n        && request.resource.data.sizeBytes is number\r\n        && request.resource.data.originalSizeBytes is number\r\n        && request.resource.data.storedSizeBytes is number\r\n        && isValidVisibility(request.resource.data.visibility)\r\n        && (\r\n          !request.resource.data.keys().hasAny(['projectId'])\r\n          || request.resource.data.projectId == null\r\n          || (\r\n            request.resource.data.projectId is string\r\n            && projectBelongsToCaller(request.resource.data.projectId)\r\n          )\r\n        )\r\n        && (\r\n          !request.resource.data.keys().hasAny(['projectVisibility'])\r\n          || request.resource.data.projectVisibility == null\r\n          || isValidVisibility(request.resource.data.projectVisibility)\r\n        );\r\n\r\n      allow update: if isOwner(resource.data.userId)\r\n        && request.resource.data.userId == resource.data.userId\r\n        && isValidVisibility(request.resource.data.visibility)\r\n        && (\r\n          !request.resource.data.keys().hasAny(['projectId'])\r\n          || request.resource.data.projectId == null\r\n          || (\r\n            request.resource.data.projectId is string\r\n            && projectBelongsToCaller(request.resource.data.projectId)\r\n          )\r\n        )\r\n        && (\r\n          !request.resource.data.keys().hasAny(['projectVisibility'])\r\n          || request.resource.data.projectVisibility == null\r\n          || isValidVisibility(request.resource.data.projectVisibility)\r\n        );\r\n\r\n      allow delete: if isOwner(resource.data.userId);\r\n\r\n      // ---------- hotspots (subcoleção) ----------\r\n\r\n      match /hotspots/{hotspotId} {\r\n\r\n        function parentImage() {\r\n          return get(/databases/$(database)/documents/images/$(imageId));\r\n        }\r\n\r\n        function parentImageIsPublic() {\r\n          return imageIsPubliclyReadable(parentImage().data);\r\n        }\r\n\r\n        allow get: if isOwner(parentImage().data.userId)\r\n                    || parentImageIsPublic();\r\n\r\n        allow list: if isOwner(parentImage().data.userId)\r\n                     || parentImageIsPublic();\r\n\r\n        allow create: if isOwner(parentImage().data.userId)\r\n          && request.resource.data.userId == request.auth.uid\r\n          && request.resource.data.imageId == imageId\r\n          && request.resource.data.pitch is number\r\n          && request.resource.data.yaw is number\r\n          && request.resource.data.createdAt is timestamp\r\n          && request.resource.data.updatedAt is timestamp\r\n          && (\r\n            !request.resource.data.keys().hasAny(['projectId'])\r\n            || request.resource.data.projectId is string\r\n          )\r\n          && (\r\n            (\r\n              request.resource.data.type == 'info'\r\n              && request.resource.data.title is string\r\n              && request.resource.data.description is string\r\n            )\r\n            || (\r\n              request.resource.data.type == 'scene'\r\n              && request.resource.data.targetImageId is string\r\n            )\r\n          );\r\n\r\n        allow update: if isOwner(parentImage().data.userId)\r\n          && resource.data.userId == request.auth.uid\r\n          && request.resource.data.userId == resource.data.userId\r\n          && request.resource.data.imageId == imageId\r\n          && request.resource.data.pitch == resource.data.pitch\r\n          && request.resource.data.yaw == resource.data.yaw\r\n          && (\r\n            (\r\n              resource.data.type == 'info'\r\n              && request.resource.data.type == 'info'\r\n              && request.resource.data.title is string\r\n              && request.resource.data.description is string\r\n            )\r\n            || (\r\n              resource.data.type == 'scene'\r\n              && request.resource.data.type == 'scene'\r\n              && request.resource.data.targetImageId is string\r\n            )\r\n          );\r\n\r\n        allow delete: if isOwner(parentImage().data.userId)\r\n          && resource.data.userId == request.auth.uid;\r\n      }\r\n    }\r\n  }\r\n}\r\n"}]}}
