[debug] [2026-06-11T12:26:31.821Z] >>> [apiv2][body] PUT http://127.0.0.1:8080/emulator/v1/projects/fivi360:securityRules {"ignore_errors":true,"rules":{"files":[{"name":"security.rules","content":"rules_version = '2';\r\n\r\n// --------------------------------------------------------------------------\r\n// FIVI360 — Firestore Security Rules (Sprint 13.3)\r\n//\r\n// Coleções:\r\n//   users/{userId}              — fonte única (campos públicos + privados)\r\n//   users/{userId}/public/profile — legado (descontinuado; não usar)\r\n//   slugs/{slug}                — resolução /u/:slug\r\n//   projects/{projectId}\r\n//   images/{imageId}\r\n//   images/{imageId}/hotspots/{hotspotId}\r\n//   emailQueue/{emailId}          — fila de e-mails transacionais (Resend)\r\n//\r\n// Split get vs list: queries precisam provar estaticamente os predicados\r\n// usados em allow list. Ver docs/security-rules-notes.md.\r\n// --------------------------------------------------------------------------\r\n\r\nservice cloud.firestore {\r\n  match /databases/{database}/documents {\r\n\r\n    // ---------- helpers ----------\r\n\r\n    function isSignedIn() {\r\n      return request.auth != null;\r\n    }\r\n\r\n    function isOwner(userId) {\r\n      return isSignedIn() && request.auth.uid == userId;\r\n    }\r\n\r\n    function isValidVisibility(value) {\r\n      return value in ['private', 'shared', 'public'];\r\n    }\r\n\r\n    function isShared(value) {\r\n      return value == 'shared' || value == 'public';\r\n    }\r\n\r\n    function projectDoc(projectId) {\r\n      return get(/databases/$(database)/documents/projects/$(projectId));\r\n    }\r\n\r\n    function projectExists(projectId) {\r\n      return exists(/databases/$(database)/documents/projects/$(projectId));\r\n    }\r\n\r\n    function projectBelongsToCaller(projectId) {\r\n      return projectId == null\r\n        || (\r\n          projectExists(projectId)\r\n          && projectDoc(projectId).data.userId == request.auth.uid\r\n        );\r\n    }\r\n\r\n    function isValidSlug(slug) {\r\n      return slug.matches('^[a-z0-9]+(-[a-z0-9]+)*$');\r\n    }\r\n\r\n    function isAllowedClientEmailType(type) {\r\n      return type in ['welcome', 'verify_email', 'billing_upgrade_requested'];\r\n    }\r\n\r\n    function isValidEmailQueueCreate() {\r\n      return request.resource.data.keys().hasAll(['type', 'to', 'userId', 'payload', 'status', 'createdAt'])\r\n        && request.resource.data.userId == request.auth.uid\r\n        && request.resource.data.to == request.auth.token.email\r\n        && request.resource.data.status == 'pending'\r\n        && isAllowedClientEmailType(request.resource.data.type)\r\n        && request.resource.data.to is string\r\n        && request.resource.data.payload is map\r\n        && request.resource.data.createdAt is timestamp\r\n        && !request.resource.data.keys().hasAny(['sentAt', 'resendId', 'error']);\r\n    }\r\n\r\n    // Portfólio /u/:slug — listagem de projetos públicos exige portfolioEnabled.\r\n    // get individual de projeto shared/public (ex.: /share/project) não usa este helper.\r\n    function portfolioEnabledForOwner(userId) {\r\n      return exists(/databases/$(database)/documents/users/$(userId))\r\n        && get(/databases/$(database)/documents/users/$(userId)).data.portfolioEnabled == true;\r\n    }\r\n\r\n    // Leitura pública limitada de users/{uid} (perfil de portfólio / share).\r\n    function isPubliclyReadableUser() {\r\n      return resource.data.portfolioEnabled == true\r\n        || (\r\n          resource.data.publicSlug is string\r\n          && resource.data.publicSlug.size() > 0\r\n          && isValidSlug(resource.data.publicSlug)\r\n        );\r\n    }\r\n\r\n    // Query users where publicSlug == slug (getPublicUserBySlug).\r\n    function isPublicSlugListQuery() {\r\n      return request.query.limit <= 1\r\n        && request.query.filters.size() == 1\r\n        && request.query.filters[0].fieldPath == 'publicSlug'\r\n        && request.query.filters[0].op == '=='\r\n        && request.query.filters[0].value is string\r\n        && isValidSlug(request.query.filters[0].value);\r\n    }\r\n\r\n    // Projeto shared/public — usado em get/list de imagens por projectId.\r\n    function isPublicProject(projectId) {\r\n      return projectExists(projectId)\r\n        && isShared(projectDoc(projectId).data.visibility);\r\n    }\r\n\r\n    // Get individual: imagem shared OU projeto pai shared/public.\r\n    function imageIsPubliclyReadable(imageData) {\r\n      return isShared(imageData.visibility)\r\n        || (\r\n          imageData.projectId != null\r\n          && isPublicProject(imageData.projectId)\r\n        );\r\n    }\r\n\r\n    // List por projectId: só quando o projeto pai é shared/public.\r\n    // Imagens shared em projeto private são acessíveis via get, não via list.\r\n    function imageListableInPublicProject(imageData) {\r\n      return imageData.projectId != null\r\n        && isPublicProject(imageData.projectId);\r\n    }\r\n\r\n    // ---------- emailQueue (transacional — ver docs/resend-email-plan.md) ----------\r\n    // Fase 1: create restrito no cliente; leitura/update/delete só via Admin SDK (Functions).\r\n    // Risco: usuário pode enfileirar e-mails repetidos para si — migrar enqueue para Functions.\r\n\r\n    match /emailQueue/{emailId} {\r\n\r\n      allow get, list: if false;\r\n\r\n      allow create: if isSignedIn() && isValidEmailQueueCreate();\r\n\r\n      allow update, delete: if false;\r\n    }\r\n\r\n    // ---------- slugs ----------\r\n\r\n    match /slugs/{slug} {\r\n\r\n      allow get: if true;\r\n      allow list: if false;\r\n\r\n      allow create: if isSignedIn()\r\n        && request.resource.data.uid == request.auth.uid\r\n        && request.resource.data.createdAt is timestamp\r\n        && isValidSlug(slug);\r\n\r\n      allow update: if false;\r\n\r\n      allow delete: if isSignedIn()\r\n        && resource.data.uid == request.auth.uid;\r\n    }\r\n\r\n    // ---------- users ----------\r\n\r\n    match /users/{userId} {\r\n\r\n      // get: owner ou perfil com slug/portfólio (DTO no cliente — ver userMappers).\r\n      allow get: if isOwner(userId) || isPubliclyReadableUser();\r\n\r\n      // list: apenas query por publicSlug (portfólio /u/:slug).\r\n      allow list: if isPublicSlugListQuery()\r\n        && resource.data.portfolioEnabled == true\r\n        && resource.data.publicSlug == request.query.filters[0].value;\r\n\r\n      allow create: if isOwner(userId);\r\n      allow update: if isOwner(userId);\r\n      allow delete: if isOwner(userId);\r\n\r\n      // Legado (Sprint 13.3): users/{uid}/public/profile — descontinuado.\r\n      // Documentos existentes não são apagados; o app não lê/escreve mais aqui.\r\n      match /public/profile {\r\n\r\n        allow get: if isOwner(userId);\r\n        allow list: if false;\r\n\r\n        allow create: if isOwner(userId);\r\n        allow update: if isOwner(userId);\r\n        allow delete: if isOwner(userId);\r\n      }\r\n    }\r\n\r\n    // ---------- projects ----------\r\n\r\n    match /projects/{projectId} {\r\n\r\n      allow get: if isOwner(resource.data.userId)\r\n                  || isShared(resource.data.visibility);\r\n\r\n      allow list: if\r\n        (isSignedIn() && resource.data.userId == request.auth.uid)\r\n        || (\r\n          isShared(resource.data.visibility)\r\n          && portfolioEnabledForOwner(resource.data.userId)\r\n        );\r\n\r\n      allow create: if isSignedIn()\r\n        && request.resource.data.userId == request.auth.uid\r\n        && request.resource.data.title is string\r\n        && request.resource.data.description is string\r\n        && request.resource.data.coverImage is string\r\n        && isValidVisibility(request.resource.data.visibility);\r\n\r\n      allow update: if isOwner(resource.data.userId)\r\n        && request.resource.data.userId == resource.data.userId\r\n        && request.resource.data.title is string\r\n        && request.resource.data.description is string\r\n        && request.resource.data.coverImage is string\r\n        && isValidVisibility(request.resource.data.visibility);\r\n\r\n      allow delete: if isOwner(resource.data.userId);\r\n    }\r\n\r\n    // ---------- images ----------\r\n\r\n    match /images/{imageId} {\r\n\r\n      allow get: if isOwner(resource.data.userId)\r\n                  || imageIsPubliclyReadable(resource.data);\r\n\r\n      // Owner: where('userId', '==', authUid) [+ projectId].\r\n      // Público: where('projectId', '==', X) — permitido só se projeto X é shared/public.\r\n      allow list: if\r\n        (isSignedIn() && resource.data.userId == request.auth.uid)\r\n        || imageListableInPublicProject(resource.data);\r\n\r\n      allow create: if isSignedIn()\r\n        && request.resource.data.userId == request.auth.uid\r\n        && request.resource.data.title is string\r\n        && request.resource.data.previewUrl is string\r\n        && request.resource.data.originalUrl is string\r\n        && request.resource.data.sizeBytes is number\r\n        && isValidVisibility(request.resource.data.visibility)\r\n        && (\r\n          !request.resource.data.keys().hasAny(['projectId'])\r\n          || request.resource.data.projectId == null\r\n          || (\r\n            request.resource.data.projectId is string\r\n            && projectBelongsToCaller(request.resource.data.projectId)\r\n          )\r\n        )\r\n        && (\r\n          !request.resource.data.keys().hasAny(['projectVisibility'])\r\n          || request.resource.data.projectVisibility == null\r\n          || isValidVisibility(request.resource.data.projectVisibility)\r\n        );\r\n\r\n      allow update: if isOwner(resource.data.userId)\r\n        && request.resource.data.userId == resource.data.userId\r\n        && isValidVisibility(request.resource.data.visibility)\r\n        && (\r\n          !request.resource.data.keys().hasAny(['projectId'])\r\n          || request.resource.data.projectId == null\r\n          || (\r\n            request.resource.data.projectId is string\r\n            && projectBelongsToCaller(request.resource.data.projectId)\r\n          )\r\n        )\r\n        && (\r\n          !request.resource.data.keys().hasAny(['projectVisibility'])\r\n          || request.resource.data.projectVisibility == null\r\n          || isValidVisibility(request.resource.data.projectVisibility)\r\n        );\r\n\r\n      allow delete: if isOwner(resource.data.userId);\r\n\r\n      // ---------- hotspots (subcoleção) ----------\r\n\r\n      match /hotspots/{hotspotId} {\r\n\r\n        function parentImage() {\r\n          return get(/databases/$(database)/documents/images/$(imageId));\r\n        }\r\n\r\n        function parentImageIsPublic() {\r\n          return imageIsPubliclyReadable(parentImage().data);\r\n        }\r\n\r\n        allow get: if isOwner(parentImage().data.userId)\r\n                    || parentImageIsPublic();\r\n\r\n        allow list: if isOwner(parentImage().data.userId)\r\n                     || parentImageIsPublic();\r\n\r\n        allow create: if isOwner(parentImage().data.userId)\r\n          && request.resource.data.userId == request.auth.uid\r\n          && request.resource.data.imageId == imageId\r\n          && request.resource.data.pitch is number\r\n          && request.resource.data.yaw is number\r\n          && request.resource.data.createdAt is timestamp\r\n          && request.resource.data.updatedAt is timestamp\r\n          && (\r\n            !request.resource.data.keys().hasAny(['projectId'])\r\n            || request.resource.data.projectId is string\r\n          )\r\n          && (\r\n            (\r\n              request.resource.data.type == 'info'\r\n              && request.resource.data.title is string\r\n              && request.resource.data.description is string\r\n            )\r\n            || (\r\n              request.resource.data.type == 'scene'\r\n              && request.resource.data.targetImageId is string\r\n            )\r\n          );\r\n\r\n        allow update: if isOwner(parentImage().data.userId)\r\n          && resource.data.userId == request.auth.uid\r\n          && request.resource.data.userId == resource.data.userId\r\n          && request.resource.data.imageId == imageId\r\n          && request.resource.data.pitch == resource.data.pitch\r\n          && request.resource.data.yaw == resource.data.yaw\r\n          && (\r\n            (\r\n              resource.data.type == 'info'\r\n              && request.resource.data.type == 'info'\r\n              && request.resource.data.title is string\r\n              && request.resource.data.description is string\r\n            )\r\n            || (\r\n              resource.data.type == 'scene'\r\n              && request.resource.data.type == 'scene'\r\n              && request.resource.data.targetImageId is string\r\n            )\r\n          );\r\n\r\n        allow delete: if isOwner(parentImage().data.userId)\r\n          && resource.data.userId == request.auth.uid;\r\n      }\r\n    }\r\n  }\r\n}\r\n"}]}}
