rules_version = '2';

// --------------------------------------------------------------------------
// FIVI360 — Firestore Security Rules (RC-P0.5 — Firestore Rules Hardening)
//
// Coleções:
//   users/{userId}              — dados privados (plano, billing, legal)
//   publicProfiles/{userId}     — dados públicos do portfólio
//   workspaces/{workspaceId}    — fundação multiusuário (workspace pessoal)
//   workspaces/{workspaceId}/members/{uid}
//   slugs/{slug}                — resolução /u/:slug
//   projects/{projectId}
//   images/{imageId}
//   images/{imageId}/hotspots/{hotspotId}
//   stats/{userId}                  — contadores agregados de portfólio
//   stats/{userId}/projects/{projectId} — contadores de projeto público
//   stats/{userId}/images/{imageId}     — contadores de imagem 360 pública
//   invoices/{invoiceId}          — faturas Stripe (escrita via webhook / Admin SDK)
//   emailQueue/{emailId}          — fila de e-mails transacionais (Resend)
//
// Admin SDK / Cloud Functions ignoram estas rules e continuam gravando
// plan, billing, portfolioAvailable, emailVerified*, etc.
//
// Split get vs list: queries precisam provar estaticamente os predicados
// usados em allow list. Ver docs/security-rules-notes.md.
// --------------------------------------------------------------------------

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidVisibility(value) {
      return value in ['private', 'shared', 'public'];
    }

    function isShared(value) {
      return value == 'shared' || value == 'public';
    }

    function projectDoc(projectId) {
      return get(/databases/$(database)/documents/projects/$(projectId));
    }

    function projectExists(projectId) {
      return exists(/databases/$(database)/documents/projects/$(projectId));
    }

    function projectBelongsToCaller(projectId) {
      return projectId == null
        || (
          projectExists(projectId)
          && projectDoc(projectId).data.userId == request.auth.uid
        );
    }

    function isValidSlug(slug) {
      return slug.matches('^[a-z0-9]+(-[a-z0-9]+)*$');
    }

    function isAllowedClientEmailType(type) {
      return type in ['welcome', 'verify_email', 'billing_upgrade_requested'];
    }

    function isValidEmailQueueCreate() {
      return request.resource.data.keys().hasAll(['type', 'to', 'userId', 'payload', 'status', 'createdAt'])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.to == request.auth.token.email
        && request.resource.data.status == 'pending'
        && isAllowedClientEmailType(request.resource.data.type)
        && request.resource.data.to is string
        && request.resource.data.payload is map
        && request.resource.data.createdAt is timestamp
        && !request.resource.data.keys().hasAny(['sentAt', 'resendId', 'error']);
    }

    // ---------- RC-P0.5: users / publicProfiles field hardening ----------

    // Bootstrap billing mínimo (espelha DEFAULT_BILLING — Stripe / free).
    // Após o create, billing é imutável pelo cliente (Stripe/webhook via Admin SDK).
    function isStarterBootstrapBilling(billing) {
      return billing is map
        && billing.keys().hasOnly([
          'provider',
          'subscriptionStatus'
        ])
        && billing.provider == 'stripe'
        && billing.subscriptionStatus == 'free';
    }

    function isValidLegalConsent(consent) {
      return consent is map
        && consent.keys().hasOnly([
          'termsAccepted',
          'privacyAccepted',
          'termsVersion',
          'privacyVersion',
          'acceptedAt',
          'acceptedSource'
        ])
        && consent.termsAccepted == true
        && consent.privacyAccepted == true
        && consent.termsVersion is string
        && consent.privacyVersion is string
        && consent.acceptedAt is timestamp
        && consent.acceptedSource in ['signup', 'modal_existing_user'];
    }

    // RC-MARKETING-CONSENT-1 — preferências de marketing (opt-in explícito).
    function isValidMarketingPreferences(prefs) {
      return prefs is map
        && prefs.keys().hasOnly([
          'enabled',
          'productUpdates',
          'offers',
          'tips',
          'newsletter',
          'research',
          'consentVersion',
          'consentSource',
          'consentedAt',
          'revokedAt',
          'updatedAt'
        ])
        && prefs.enabled is bool
        && prefs.productUpdates is bool
        && prefs.offers is bool
        && prefs.tips is bool
        && prefs.newsletter is bool
        && prefs.research is bool
        && (prefs.consentVersion == null || prefs.consentVersion is string)
        && (prefs.consentSource == null || prefs.consentSource is string)
        && (prefs.consentedAt == null || prefs.consentedAt is timestamp)
        && (prefs.revokedAt == null || prefs.revokedAt is timestamp)
        && prefs.updatedAt is timestamp
        && (
          prefs.enabled == false
          || prefs.consentedAt is timestamp
        );
    }

    function isValidSocialLinks(links) {
      return links is map
        && links.keys().hasOnly([
          'website',
          'instagram',
          'youtube',
          'linkedin',
          'whatsapp'
        ])
        && links.website is string
        && links.instagram is string
        && links.youtube is string
        && links.linkedin is string
        && links.whatsapp is string;
    }

    function userCreateFieldsAreValid(userId) {
      let data = request.resource.data;

      return data.keys().hasOnly([
          'displayName',
          'email',
          'plan',
          'billing',
          'defaultWorkspaceId',
          'activeWorkspaceId',
          'welcomeEmailQueuedAt',
          'createdAt',
          'updatedAt',
          'legalConsent',
          'marketingPreferences'
        ])
        && data.displayName is string
        && data.email is string
        && data.plan == 'starter'
        && isStarterBootstrapBilling(data.billing)
        && data.defaultWorkspaceId is string
        && data.defaultWorkspaceId == userId
        && data.activeWorkspaceId is string
        && data.activeWorkspaceId == userId
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && (
          !data.keys().hasAny(['welcomeEmailQueuedAt'])
          || data.welcomeEmailQueuedAt == null
        )
        && (
          !data.keys().hasAny(['legalConsent'])
          || isValidLegalConsent(data.legalConsent)
        )
        && (
          !data.keys().hasAny(['marketingPreferences'])
          || isValidMarketingPreferences(data.marketingPreferences)
        );
    }

    function userUpdateFieldsAreValid() {
      let affected = request.resource.data.diff(resource.data).affectedKeys();
      let data = request.resource.data;

      // Allowlist mínima — qualquer outro campo (plan, billing, admin, etc.) é negado.
      return affected.hasOnly([
          'displayName',
          'updatedAt',
          'legalConsent',
          'welcomeEmailQueuedAt',
          'marketingPreferences'
        ])
        && data.updatedAt is timestamp
        && (
          !affected.hasAny(['displayName'])
          || data.displayName is string
        )
        && (
          !affected.hasAny(['legalConsent'])
          || isValidLegalConsent(data.legalConsent)
        )
        && (
          !affected.hasAny(['welcomeEmailQueuedAt'])
          || data.welcomeEmailQueuedAt == null
          || data.welcomeEmailQueuedAt is timestamp
        )
        && (
          !affected.hasAny(['marketingPreferences'])
          || isValidMarketingPreferences(data.marketingPreferences)
        );
    }

    // portfolioAvailable: entitlement comercial — cliente nunca promove a true.
    // Demote para false é permitido (ocultar portfólio). Promote só via Admin SDK.
    function publicEntitlementFieldsUnchanged() {
      let affected = request.resource.data.diff(resource.data).affectedKeys();

      return !affected.hasAny(['portfolioAvailable'])
        || request.resource.data.portfolioAvailable == false;
    }

    function publicProfileCreateFieldsAreValid(userId) {
      let data = request.resource.data;

      return data.keys().hasOnly([
          'uid',
          'slug',
          'portfolioEnabled',
          'portfolioAvailable',
          'displayName',
          'companyName',
          'companyLogo',
          'bio',
          'socialLinks',
          'createdAt',
          'updatedAt'
        ])
        && data.uid == userId
        && data.slug is string
        && data.portfolioEnabled is bool
        && data.portfolioEnabled == false
        && data.portfolioAvailable is bool
        && data.portfolioAvailable == false
        && data.displayName is string
        && data.companyName is string
        && data.companyLogo is string
        && data.bio is string
        && isValidSocialLinks(data.socialLinks)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function publicProfileUpdateFieldsAreValid(userId) {
      let affected = request.resource.data.diff(resource.data).affectedKeys();
      let data = request.resource.data;

      return data.uid == userId
        && data.uid == resource.data.uid
        && publicEntitlementFieldsUnchanged()
        && !affected.hasAny([
          'plan',
          'planId',
          'billing',
          'subscription',
          'subscriptionStatus',
          'featureFlags',
          'premiumFeatures',
          'portfolioEnabledByPlan',
          'analyticsAvailable',
          'hotspotsAvailable',
          'whiteLabelAvailable',
          'customDomainAvailable',
          'role',
          'admin',
          'isAdmin',
          'permissions',
          'claims',
          'createdAt'
        ])
        && affected.hasOnly([
          'uid',
          'displayName',
          'companyName',
          'companyLogo',
          'bio',
          'slug',
          'portfolioEnabled',
          'portfolioAvailable',
          'socialLinks',
          'updatedAt'
        ])
        && (
          !affected.hasAny(['portfolioAvailable'])
          || data.portfolioAvailable == false
        )
        && (
          !affected.hasAny(['displayName'])
          || data.displayName is string
        )
        && (
          !affected.hasAny(['companyName'])
          || data.companyName is string
        )
        && (
          !affected.hasAny(['companyLogo'])
          || data.companyLogo is string
        )
        && (
          !affected.hasAny(['bio'])
          || data.bio is string
        )
        && (
          !affected.hasAny(['slug'])
          || data.slug is string
        )
        && (
          !affected.hasAny(['portfolioEnabled'])
          || data.portfolioEnabled is bool
        )
        && (
          !affected.hasAny(['socialLinks'])
          || isValidSocialLinks(data.socialLinks)
        )
        && (
          !affected.hasAny(['updatedAt'])
          || data.updatedAt is timestamp
        );
    }

    // Portfólio /u/:slug — listagem de projetos públicos exige portfolioAvailable.
    // get individual de projeto shared/public (ex.: /share/project) não usa este helper.
    function portfolioAvailableForOwner(userId) {
      return exists(/databases/$(database)/documents/publicProfiles/$(userId))
        && get(/databases/$(database)/documents/publicProfiles/$(userId)).data.portfolioAvailable == true;
    }

    // Projeto shared/public — usado em get/list de imagens por projectId.
    function isPublicProject(projectId) {
      return projectExists(projectId)
        && isShared(projectDoc(projectId).data.visibility);
    }

    // Get individual: imagem shared OU projeto pai shared/public.
    function imageIsPubliclyReadable(imageData) {
      return isShared(imageData.visibility)
        || (
          imageData.projectId != null
          && isPublicProject(imageData.projectId)
        );
    }

    // List por projectId: só quando o projeto pai é shared/public.
    // Imagens shared em projeto private são acessíveis via get, não via list.
    function imageListableInPublicProject(imageData) {
      return imageData.projectId != null
        && isPublicProject(imageData.projectId);
    }

    function imageExists(imageId) {
      return exists(/databases/$(database)/documents/images/$(imageId));
    }

    function imageDocData(imageId) {
      return get(/databases/$(database)/documents/images/$(imageId)).data;
    }

    // Imagem em projeto público com portfólio ativo do dono (métricas /u/:slug/.../image).
    function isPortfolioPublicImage(imageId) {
      return imageExists(imageId)
        && imageDocData(imageId).projectId is string
        && isPublicProject(imageDocData(imageId).projectId)
        && portfolioAvailableForOwner(projectDoc(imageDocData(imageId).projectId).data.userId);
    }

    // Imagem pública pertencente ao userId do path stats/{userId}/images/{imageId}.
    function isPortfolioPublicImageForOwner(imageId, ownerUserId) {
      return imageExists(imageId)
        && imageDocData(imageId).userId == ownerUserId
        && imageDocData(imageId).projectId is string
        && isPublicProject(imageDocData(imageId).projectId)
        && projectDoc(imageDocData(imageId).projectId).data.userId == ownerUserId
        && portfolioAvailableForOwner(ownerUserId);
    }

    // ---------- stats (visualizações públicas agrupadas por usuário) ----------

    match /stats/{userId} {

      allow get: if isOwner(userId);
      allow list: if false;

      function isValidStatsRootMutation() {
        let data = request.resource.data;

        return portfolioAvailableForOwner(userId)
          && data.keys().hasOnly(['portfolioViews', 'updatedAt'])
          && data.portfolioViews is int
          && data.portfolioViews >= 1
          && data.updatedAt is timestamp
          && (
            !exists(/databases/$(database)/documents/stats/$(userId))
              ? data.portfolioViews == 1
              : data.portfolioViews == resource.data.portfolioViews + 1
          );
      }

      allow create, update: if isValidStatsRootMutation();
      allow delete: if false;

      match /projects/{projectId} {

        allow get: if isOwner(userId);
        allow list: if isOwner(userId);

        function isValidStatsProjectMutation() {
          let data = request.resource.data;

          return projectExists(projectId)
            && projectDoc(projectId).data.userId == userId
            && isShared(projectDoc(projectId).data.visibility)
            && portfolioAvailableForOwner(userId)
            && data.keys().hasOnly(['views', 'updatedAt'])
            && data.views is int
            && data.views >= 1
            && data.updatedAt is timestamp
            && (
              !exists(/databases/$(database)/documents/stats/$(userId)/projects/$(projectId))
                ? data.views == 1
                : data.views == resource.data.views + 1
            );
        }

        allow create, update: if isValidStatsProjectMutation();
        allow delete: if false;
      }

      match /images/{imageId} {

        allow get: if isOwner(userId);
        allow list: if isOwner(userId);

        function isValidStatsImageMutation() {
          let data = request.resource.data;

          return isPortfolioPublicImageForOwner(imageId, userId)
            && data.keys().hasOnly(['views', 'updatedAt'])
            && data.views is int
            && data.views >= 1
            && data.updatedAt is timestamp
            && (
              !exists(/databases/$(database)/documents/stats/$(userId)/images/$(imageId))
                ? data.views == 1
                : data.views == resource.data.views + 1
            );
        }

        allow create, update: if isValidStatsImageMutation();
        // Dono pode limpar stats órfãos na exclusão cascade da imagem (RC-P0.6).
        allow delete: if isOwner(userId);
      }
    }

    // ---------- invoices (Stripe — escrita só via Admin SDK / webhook) ----------

    match /invoices/{invoiceId} {

      allow get: if isSignedIn()
        && resource.data.userId == request.auth.uid;

      allow list: if isSignedIn()
        && resource.data.userId == request.auth.uid;

      allow create, update, delete: if false;
    }

    // ---------- emailQueue (transacional — ver docs/resend-email-plan.md) ----------
    // Fase 1: create restrito no cliente; leitura/update/delete só via Admin SDK (Functions).
    // Risco: usuário pode enfileirar e-mails repetidos para si — migrar enqueue para Functions.

    match /emailQueue/{emailId} {

      allow get, list: if false;

      allow create: if isSignedIn() && isValidEmailQueueCreate();

      allow update, delete: if false;
    }

    // ---------- slugs ----------

    match /slugs/{slug} {

      allow get: if true;
      allow list: if false;

      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.type == 'user'
        && request.resource.data.createdAt is timestamp
        && isValidSlug(slug);

      allow update: if false;

      allow delete: if isSignedIn()
        && resource.data.uid == request.auth.uid;
    }

    // ---------- publicProfiles (dados públicos do portfólio) ----------
    // portfolioAvailable: SERVER_ONLY promote (Admin SDK / syncPublicPortfolioAvailability).
    // Cliente pode demote para false ao desativar o portfólio.

    match /publicProfiles/{userId} {

      allow get: if isOwner(userId)
        || resource.data.portfolioAvailable == true;

      allow list: if false;

      allow create: if isOwner(userId)
        && publicProfileCreateFieldsAreValid(userId);

      allow update: if isOwner(userId)
        && publicProfileUpdateFieldsAreValid(userId);

      allow delete: if false;
    }

    // ---------- workspaces (fundação multiusuário — Sprint Multiuser Foundation 1) ----------

    function workspaceExists(workspaceId) {
      return exists(/databases/$(database)/documents/workspaces/$(workspaceId));
    }

    function workspaceDoc(workspaceId) {
      return get(/databases/$(database)/documents/workspaces/$(workspaceId));
    }

    function isWorkspaceMember(workspaceId) {
      return isSignedIn()
        && workspaceExists(workspaceId)
        && exists(/databases/$(database)/documents/workspaces/$(workspaceId)/members/$(request.auth.uid))
        && get(/databases/$(database)/documents/workspaces/$(workspaceId)/members/$(request.auth.uid)).data.status == 'active';
    }

    function isWorkspaceOwner(workspaceId) {
      return isSignedIn()
        && workspaceExists(workspaceId)
        && workspaceDoc(workspaceId).data.ownerId == request.auth.uid;
    }

    // Bootstrap do workspace pessoal em batch (workspace + member na mesma operação).
    // exists()/get() no workspace pai ainda não enxergam writes anteriores do batch.
    function isPersonalWorkspaceMemberBootstrap(workspaceId, memberId) {
      return isSignedIn()
        && workspaceId == request.auth.uid
        && memberId == request.auth.uid
        && request.resource.data.userId == memberId
        && request.resource.data.role == 'owner'
        && request.resource.data.status == 'active'
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    match /workspaces/{workspaceId} {

      allow get: if isWorkspaceMember(workspaceId);
      allow list: if false;

      allow create: if isSignedIn()
        && request.resource.data.ownerId == request.auth.uid
        && workspaceId == request.auth.uid
        && request.resource.data.type == 'personal'
        && request.resource.data.planId == 'starter'
        && request.resource.data.name is string
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;

      allow update: if isWorkspaceOwner(workspaceId)
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.type == resource.data.type
        // RC-P0.5A: planId não é fonte de entitlement, mas não pode ser alterado pelo cliente.
        && request.resource.data.planId == resource.data.planId
        && request.resource.data.name is string
        && request.resource.data.updatedAt is timestamp;

      allow delete: if false;

      match /members/{memberId} {

        allow get: if isWorkspaceMember(workspaceId);
        allow list: if isWorkspaceMember(workspaceId);

        allow create: if (
          isWorkspaceOwner(workspaceId)
          || isPersonalWorkspaceMemberBootstrap(workspaceId, memberId)
        )
          && request.resource.data.userId == memberId
          && request.resource.data.role == 'owner'
          && request.resource.data.status == 'active'
          && request.resource.data.createdAt is timestamp
          && request.resource.data.updatedAt is timestamp;

        allow update: if isWorkspaceOwner(workspaceId)
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.role is string
          && request.resource.data.status is string
          && request.resource.data.updatedAt is timestamp;

        allow delete: if isWorkspaceOwner(workspaceId);
      }
    }

    // ---------- users (dados privados — owner only) ----------
    // plan / billing: bootstrap starter no create; updates só via Admin SDK.
    // Allowlist de update: displayName, legalConsent, welcomeEmailQueuedAt,
    // marketingPreferences, updatedAt.

    match /users/{userId} {

      allow get: if isOwner(userId);
      allow list: if false;

      allow create: if isOwner(userId)
        && userCreateFieldsAreValid(userId);

      allow update: if isOwner(userId)
        && userUpdateFieldsAreValid();

      allow delete: if false;
    }

    // ---------- projects ----------

    match /projects/{projectId} {

      allow get: if isOwner(resource.data.userId)
                  || isShared(resource.data.visibility);

      allow list: if
        (isSignedIn() && resource.data.userId == request.auth.uid)
        || (
          isShared(resource.data.visibility)
          && portfolioAvailableForOwner(resource.data.userId)
        );

      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.description is string
        && request.resource.data.coverImage is string
        && isValidVisibility(request.resource.data.visibility);

      allow update: if isOwner(resource.data.userId)
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.title is string
        && request.resource.data.description is string
        && request.resource.data.coverImage is string
        && isValidVisibility(request.resource.data.visibility);

      allow delete: if isOwner(resource.data.userId);
    }

    // ---------- images ----------

    match /images/{imageId} {

      allow get: if isOwner(resource.data.userId)
                  || imageIsPubliclyReadable(resource.data);

      // Owner: where('userId', '==', authUid) [+ projectId].
      // Público: where('projectId', '==', X) — permitido só se projeto X é shared/public.
      allow list: if
        (isSignedIn() && resource.data.userId == request.auth.uid)
        || imageListableInPublicProject(resource.data);

      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.previewUrl is string
        && request.resource.data.originalUrl is string
        && request.resource.data.sizeBytes is number
        && isValidVisibility(request.resource.data.visibility)
        && (
          !request.resource.data.keys().hasAny(['projectId'])
          || request.resource.data.projectId == null
          || (
            request.resource.data.projectId is string
            && projectBelongsToCaller(request.resource.data.projectId)
          )
        )
        && (
          !request.resource.data.keys().hasAny(['projectVisibility'])
          || request.resource.data.projectVisibility == null
          || isValidVisibility(request.resource.data.projectVisibility)
        );

      allow update: if isOwner(resource.data.userId)
        && request.resource.data.userId == resource.data.userId
        && isValidVisibility(request.resource.data.visibility)
        && (
          !request.resource.data.keys().hasAny(['projectId'])
          || request.resource.data.projectId == null
          || (
            request.resource.data.projectId is string
            && projectBelongsToCaller(request.resource.data.projectId)
          )
        )
        && (
          !request.resource.data.keys().hasAny(['projectVisibility'])
          || request.resource.data.projectVisibility == null
          || isValidVisibility(request.resource.data.projectVisibility)
        );

      allow delete: if isOwner(resource.data.userId);

      // ---------- hotspots (subcoleção) ----------

      match /hotspots/{hotspotId} {

        function parentImage() {
          return get(/databases/$(database)/documents/images/$(imageId));
        }

        function parentImageIsPublic() {
          return imageIsPubliclyReadable(parentImage().data);
        }

        allow get: if isOwner(parentImage().data.userId)
                    || parentImageIsPublic();

        allow list: if isOwner(parentImage().data.userId)
                     || parentImageIsPublic();

        allow create: if isOwner(parentImage().data.userId)
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.imageId == imageId
          && request.resource.data.pitch is number
          && request.resource.data.yaw is number
          && request.resource.data.createdAt is timestamp
          && request.resource.data.updatedAt is timestamp
          && (
            !request.resource.data.keys().hasAny(['projectId'])
            || request.resource.data.projectId is string
          )
          && (
            (
              request.resource.data.type == 'info'
              && request.resource.data.title is string
              && request.resource.data.description is string
            )
            || (
              request.resource.data.type == 'scene'
              && request.resource.data.targetImageId is string
            )
          );

        allow update: if isOwner(parentImage().data.userId)
          && resource.data.userId == request.auth.uid
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.imageId == imageId
          && request.resource.data.pitch == resource.data.pitch
          && request.resource.data.yaw == resource.data.yaw
          && (
            (
              resource.data.type == 'info'
              && request.resource.data.type == 'info'
              && request.resource.data.title is string
              && request.resource.data.description is string
            )
            || (
              resource.data.type == 'scene'
              && request.resource.data.type == 'scene'
              && request.resource.data.targetImageId is string
            )
          );

        allow delete: if isOwner(parentImage().data.userId)
          && resource.data.userId == request.auth.uid;
      }
    }
  }
}
