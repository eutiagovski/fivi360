rules_version = '2';

// --------------------------------------------------------------------------
// FIVI360 — Firestore Security Rules (Sprint 13.3)
//
// Coleções:
//   users/{userId}              — fonte única (campos públicos + privados)
//   users/{userId}/public/profile — legado (descontinuado; não usar)
//   slugs/{slug}                — resolução /u/:slug
//   projects/{projectId}
//   images/{imageId}
//   images/{imageId}/hotspots/{hotspotId}
//   emailQueue/{emailId}          — fila de e-mails transacionais (Resend)
//   subscriptions/{userId}        — assinatura Mercado Pago (1 doc por usuário)
//   invoices/{invoiceId}          — faturas/cobranças por usuário
//   billingCheckoutSessions/{sessionId} — tentativas de checkout antes do redirect MP
//   billingWebhookEvents/{eventId}      — payloads brutos de webhook MP (diagnóstico)
//
// Split get vs list: queries precisam provar estaticamente os predicados
// usados em allow list. Ver docs/security-rules-notes.md.
// --------------------------------------------------------------------------

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidVisibility(value) {
      return value in ['private', 'shared', 'public'];
    }

    function isShared(value) {
      return value == 'shared' || value == 'public';
    }

    function projectDoc(projectId) {
      return get(/databases/$(database)/documents/projects/$(projectId));
    }

    function projectExists(projectId) {
      return exists(/databases/$(database)/documents/projects/$(projectId));
    }

    function projectBelongsToCaller(projectId) {
      return projectId == null
        || (
          projectExists(projectId)
          && projectDoc(projectId).data.userId == request.auth.uid
        );
    }

    function isValidSlug(slug) {
      return slug.matches('^[a-z0-9]+(-[a-z0-9]+)*$');
    }

    function isAllowedClientEmailType(type) {
      return type in ['welcome', 'verify_email', 'billing_upgrade_requested'];
    }

    function isValidEmailQueueCreate() {
      return request.resource.data.keys().hasAll(['type', 'to', 'userId', 'payload', 'status', 'createdAt'])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.to == request.auth.token.email
        && request.resource.data.status == 'pending'
        && isAllowedClientEmailType(request.resource.data.type)
        && request.resource.data.to is string
        && request.resource.data.payload is map
        && request.resource.data.createdAt is timestamp
        && !request.resource.data.keys().hasAny(['sentAt', 'resendId', 'error']);
    }

    // Portfólio /u/:slug — listagem de projetos públicos exige portfolioEnabled.
    // get individual de projeto shared/public (ex.: /share/project) não usa este helper.
    function portfolioEnabledForOwner(userId) {
      return exists(/databases/$(database)/documents/users/$(userId))
        && get(/databases/$(database)/documents/users/$(userId)).data.portfolioEnabled == true;
    }

    // Leitura pública limitada de users/{uid} (perfil de portfólio / share).
    function isPubliclyReadableUser() {
      return resource.data.portfolioEnabled == true
        || (
          resource.data.publicSlug is string
          && resource.data.publicSlug.size() > 0
          && isValidSlug(resource.data.publicSlug)
        );
    }

    // Query users where publicSlug == slug (getPublicUserBySlug).
    function isPublicSlugListQuery() {
      return request.query.limit <= 1
        && request.query.filters.size() == 1
        && request.query.filters[0].fieldPath == 'publicSlug'
        && request.query.filters[0].op == '=='
        && request.query.filters[0].value is string
        && isValidSlug(request.query.filters[0].value);
    }

    // Projeto shared/public — usado em get/list de imagens por projectId.
    function isPublicProject(projectId) {
      return projectExists(projectId)
        && isShared(projectDoc(projectId).data.visibility);
    }

    // Get individual: imagem shared OU projeto pai shared/public.
    function imageIsPubliclyReadable(imageData) {
      return isShared(imageData.visibility)
        || (
          imageData.projectId != null
          && isPublicProject(imageData.projectId)
        );
    }

    // List por projectId: só quando o projeto pai é shared/public.
    // Imagens shared em projeto private são acessíveis via get, não via list.
    function imageListableInPublicProject(imageData) {
      return imageData.projectId != null
        && isPublicProject(imageData.projectId);
    }

    // Query invoices where userId == auth.uid (histórico de cobrança).
    function isOwnerInvoiceListQuery() {
      return request.query.limit <= 50
        && request.query.filters.size() == 1
        && request.query.filters[0].fieldPath == 'userId'
        && request.query.filters[0].op == '=='
        && request.query.filters[0].value == request.auth.uid;
    }

    // Query billingCheckoutSessions where userId == auth.uid.
    function isOwnerCheckoutSessionListQuery() {
      return request.query.limit <= 50
        && request.query.filters.size() == 1
        && request.query.filters[0].fieldPath == 'userId'
        && request.query.filters[0].op == '=='
        && request.query.filters[0].value == request.auth.uid;
    }

    // ---------- subscriptions (billing — ver docs/billing-foundation.md) ----------
    // Leitura: owner. Escrita: apenas Admin SDK / Cloud Functions.

    match /subscriptions/{userId} {

      allow get: if isOwner(userId);
      allow list: if false;

      allow create, update, delete: if false;
    }

    // ---------- invoices (billing — ver docs/billing-foundation.md) ----------
    // Leitura: owner. Escrita: apenas Admin SDK / Cloud Functions.

    match /invoices/{invoiceId} {

      allow get: if isSignedIn()
        && resource.data.userId == request.auth.uid;

      allow list: if isSignedIn()
        && isOwnerInvoiceListQuery()
        && resource.data.userId == request.auth.uid;

      allow create, update, delete: if false;
    }

    // ---------- billingCheckoutSessions (billing — rastreio de checkout MP) ----------
    // Leitura: owner. Escrita: apenas Admin SDK / Cloud Functions.

    match /billingCheckoutSessions/{sessionId} {

      allow get: if isSignedIn()
        && resource.data.userId == request.auth.uid;

      allow list: if isSignedIn()
        && isOwnerCheckoutSessionListQuery()
        && resource.data.userId == request.auth.uid;

      allow create, update, delete: if false;
    }

    // ---------- billingWebhookEvents (billing — diagnóstico webhook MP) ----------
    // Somente Admin SDK / Cloud Functions.

    match /billingWebhookEvents/{eventId} {

      allow get, list, create, update, delete: if false;
    }

    // ---------- emailQueue (transacional — ver docs/resend-email-plan.md) ----------
    // Fase 1: create restrito no cliente; leitura/update/delete só via Admin SDK (Functions).
    // Risco: usuário pode enfileirar e-mails repetidos para si — migrar enqueue para Functions.

    match /emailQueue/{emailId} {

      allow get, list: if false;

      allow create: if isSignedIn() && isValidEmailQueueCreate();

      allow update, delete: if false;
    }

    // ---------- slugs ----------

    match /slugs/{slug} {

      allow get: if true;
      allow list: if false;

      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.createdAt is timestamp
        && isValidSlug(slug);

      allow update: if false;

      allow delete: if isSignedIn()
        && resource.data.uid == request.auth.uid;
    }

    // ---------- users ----------

    match /users/{userId} {

      // get: owner ou perfil com slug/portfólio (DTO no cliente — ver userMappers).
      allow get: if isOwner(userId) || isPubliclyReadableUser();

      // list: apenas query por publicSlug (portfólio /u/:slug).
      allow list: if isPublicSlugListQuery()
        && resource.data.portfolioEnabled == true
        && resource.data.publicSlug == request.query.filters[0].value;

      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);

      // Legado (Sprint 13.3): users/{uid}/public/profile — descontinuado.
      // Documentos existentes não são apagados; o app não lê/escreve mais aqui.
      match /public/profile {

        allow get: if isOwner(userId);
        allow list: if false;

        allow create: if isOwner(userId);
        allow update: if isOwner(userId);
        allow delete: if isOwner(userId);
      }
    }

    // ---------- projects ----------

    match /projects/{projectId} {

      allow get: if isOwner(resource.data.userId)
                  || isShared(resource.data.visibility);

      allow list: if
        (isSignedIn() && resource.data.userId == request.auth.uid)
        || (
          isShared(resource.data.visibility)
          && portfolioEnabledForOwner(resource.data.userId)
        );

      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.description is string
        && request.resource.data.coverImage is string
        && isValidVisibility(request.resource.data.visibility);

      allow update: if isOwner(resource.data.userId)
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.title is string
        && request.resource.data.description is string
        && request.resource.data.coverImage is string
        && isValidVisibility(request.resource.data.visibility);

      allow delete: if isOwner(resource.data.userId);
    }

    // ---------- images ----------

    match /images/{imageId} {

      allow get: if isOwner(resource.data.userId)
                  || imageIsPubliclyReadable(resource.data);

      // Owner: where('userId', '==', authUid) [+ projectId].
      // Público: where('projectId', '==', X) — permitido só se projeto X é shared/public.
      allow list: if
        (isSignedIn() && resource.data.userId == request.auth.uid)
        || imageListableInPublicProject(resource.data);

      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.previewUrl is string
        && request.resource.data.originalUrl is string
        && request.resource.data.sizeBytes is number
        && isValidVisibility(request.resource.data.visibility)
        && (
          !request.resource.data.keys().hasAny(['projectId'])
          || request.resource.data.projectId == null
          || (
            request.resource.data.projectId is string
            && projectBelongsToCaller(request.resource.data.projectId)
          )
        )
        && (
          !request.resource.data.keys().hasAny(['projectVisibility'])
          || request.resource.data.projectVisibility == null
          || isValidVisibility(request.resource.data.projectVisibility)
        );

      allow update: if isOwner(resource.data.userId)
        && request.resource.data.userId == resource.data.userId
        && isValidVisibility(request.resource.data.visibility)
        && (
          !request.resource.data.keys().hasAny(['projectId'])
          || request.resource.data.projectId == null
          || (
            request.resource.data.projectId is string
            && projectBelongsToCaller(request.resource.data.projectId)
          )
        )
        && (
          !request.resource.data.keys().hasAny(['projectVisibility'])
          || request.resource.data.projectVisibility == null
          || isValidVisibility(request.resource.data.projectVisibility)
        );

      allow delete: if isOwner(resource.data.userId);

      // ---------- hotspots (subcoleção) ----------

      match /hotspots/{hotspotId} {

        function parentImage() {
          return get(/databases/$(database)/documents/images/$(imageId));
        }

        function parentImageIsPublic() {
          return imageIsPubliclyReadable(parentImage().data);
        }

        allow get: if isOwner(parentImage().data.userId)
                    || parentImageIsPublic();

        allow list: if isOwner(parentImage().data.userId)
                     || parentImageIsPublic();

        allow create: if isOwner(parentImage().data.userId)
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.imageId == imageId
          && request.resource.data.pitch is number
          && request.resource.data.yaw is number
          && request.resource.data.createdAt is timestamp
          && request.resource.data.updatedAt is timestamp
          && (
            !request.resource.data.keys().hasAny(['projectId'])
            || request.resource.data.projectId is string
          )
          && (
            (
              request.resource.data.type == 'info'
              && request.resource.data.title is string
              && request.resource.data.description is string
            )
            || (
              request.resource.data.type == 'scene'
              && request.resource.data.targetImageId is string
            )
          );

        allow update: if isOwner(parentImage().data.userId)
          && resource.data.userId == request.auth.uid
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.imageId == imageId
          && request.resource.data.pitch == resource.data.pitch
          && request.resource.data.yaw == resource.data.yaw
          && (
            (
              resource.data.type == 'info'
              && request.resource.data.type == 'info'
              && request.resource.data.title is string
              && request.resource.data.description is string
            )
            || (
              resource.data.type == 'scene'
              && request.resource.data.type == 'scene'
              && request.resource.data.targetImageId is string
            )
          );

        allow delete: if isOwner(parentImage().data.userId)
          && resource.data.userId == request.auth.uid;
      }
    }
  }
}
